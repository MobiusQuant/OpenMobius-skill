{
  "global_card_id": "parallel_channel",
  "global_canonical": "Parallel Channel",
  "type": "merged_concept",
  "school": "Price Action",
  "aliases": [
    "Channel",
    "Downtrend Channel"
  ],
  "definition": "Two parallel trend lines enclosing price action, drawn using a charting tool snapped to an existing trend line. The upper and lower boundaries define the range within which price oscillates during a trending or consolidating phase.",
  "definition_per_source": {
    "SMC-Supplement-PLv-X125": "Two parallel trend lines enclosing price action, drawn using a charting tool snapped to an existing trend line. The upper and lower boundaries define the range within which price oscillates during a trending or consolidating phase."
  },
  "identification_rules": [
    "Draw a trend line connecting consecutive swing highs or swing lows to establish the primary trend direction.",
    "Apply the parallel channel tool (e.g., TradingView's Parallel Channel) to that trend line so a second, equidistant line is automatically projected on the opposite side of price action.",
    "Confirm the channel by verifying that price respects both the upper and lower boundaries with multiple touches or near-touches.",
    "Observe whether price is trading in the upper part or lower part of the channel to gauge momentum within the trend.",
    "A break through the lower boundary of a downtrend channel or the upper boundary of an uptrend channel signals a potential new trend beginning in the breakout direction."
  ],
  "common_mistakes": [
    "Expecting the trend line to touch every swing point exactly — the channel tool should be drawn on the dominant trend line and the parallel line projected, not forced to fit every wick.",
    "Ignoring that price can move between the upper and lower parts of a channel before breaking out, leading to premature breakout entries."
  ],
  "trading_implication": "Parallel channels define the boundaries of trending price movement. Traders watch for price transitioning from the upper part to the lower part of the channel (or vice versa) to anticipate momentum shifts within the trend. When price breaks through a channel boundary, it signals the end of the current trend and the potential start of a new one. Channels provide context for where reversals and divergences are most meaningful, helping traders frame entries and exits relative to structural boundaries.",
  "merge_notes": null,

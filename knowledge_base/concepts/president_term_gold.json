{
  "global_card_id": "president_term_gold",
  "global_canonical": "总统任期对黄金的影响",
  "type": "merged_concept",
  "school": "General",
  "aliases": [
    "总统党派与黄金走势",
    "政治周期对黄金的影响"
  ],
  "definition": "讲师用美国总统党派周期解释黄金长期方向的宏观判断框架：共和党执政普遍利好黄金，民主党执政则倾向先跌后涨（多在任期末才上行），可结合时区推演大周期变盘点。",
  "definition_per_source": {
    "Teach-Wuyuan": "讲师用美国总统党派周期解释黄金长期方向的宏观判断框架：共和党执政普遍利好黄金，民主党执政则倾向先跌后涨（多在任期末才上行），可结合时区推演大周期变盘点。"
  },
  "identification_rules": [
    "确认当前执政党派：共和党（红脖子/川普）在台视为黄金长期利好，倾向做多",
    "民主党在台时识别其典型路径：先经历多年下跌或长期不动，临近换届才上涨",
    "对照具体历史样本验证：2016年11月川普上台后盘整完毕即上涨，拜登时期黄金走多年下跌",
    "关注党派政策工具：民主党常用加息、监管收紧、地缘炒作（如俄乌战争）抑制金价",
    "结合月线/日线时区推演变盘节点（8、13、21、34、55等数字），将周期与任期更替时间对齐至2028-2029年"
  ],
  "common_mistakes": [
    "盲信网上所谓专业分析认为民主党利好黄金，忽视其普遍先跌后涨、涨势多出现在临近换届时（届时常由共和党接棒）",
    "把党派周期当作直接交易信号，忽略中途的剧烈调整与套牢风险（长线虽涨但回撤可能让人受不了）",
    "忽视民主党可能用俄乌战争等地缘事件短期炒高金价后随即加息打压的反复性"
  ],
  "trading_implication": "作为长线方向的背景过滤器：共和党执政期间倾向持有并逢低做多黄金，认为只要川普在台黄金难大跌，缺乏做空动力；若执政党更替为民主党或川普下台，则需警惕长期下跌或宽幅震荡，做多动力消失。讲师用此框架配合时区推演锁定2028-2029年作为潜在大周期变盘窗口，但仍强调实际进出场需回到技术位（如FVG回踩、OB、关键阻力位）执行。",
  "merge_notes": null,

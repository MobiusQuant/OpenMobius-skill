{
  "global_card_id": "consumer_price_index",
  "global_canonical": "Consumer Price Index",
  "type": "merged_concept",
  "school": "General",
  "aliases": [
    "CPI"
  ],
  "definition": "A high-impact macroeconomic news release measuring changes in consumer prices, scheduled at 8:30 ET, that drives elevated volatility and expanded price ranges. Around CPI, markets often withhold directional commitment beforehand and deliver sharp moves on release, making it both an indecision catalyst the day prior and a trigger for post-release liquidity sweeps and divergence setups between correlated assets.",
  "definition_per_source": {
    "Daily Profiles": "A high-impact macroeconomic news release measuring changes in consumer prices. The day preceding a CPI release typically produces an indecision (Seek and Destroy) daily candle profile, as participants withhold directional commitment while awaiting the announcement.",
    "Education - ICT (Updated)": "A high-impact macroeconomic news release scheduled at 8:30 ET that introduces elevated volatility and expanded price ranges. Used as a catalyst for post-release SMT divergence setups between correlated assets, with entries based on liquidity sweeps and breaker blocks formed during the release."
  },
  "identification_rules": [
    "Check the economic calendar before trading: identify CPI as the scheduled 8:30 ET release (ICT project notes the exact time) for the session.",
    "Daily Profiles emphasis: if CPI is scheduled for the following day, classify the current session as a probable Seek and Destroy / indecision profile day.",
    "On the daily chart, look for an indecision candle where open and close are at approximately the same level with extended wicks in both directions.",
    "On lower time frames (pre-CPI), confirm indecision by observing London sweeping both sides of the Asia range without sustaining directional expansion, then New York oscillating within the same range.",
    "ICT project emphasis (post-release): compare correlated assets (e.g., NQ vs ES) for SMT divergence where one sweeps a high/low into a fair value gap while the other does not.",
    "After the release, look for a high-low-higher high-lower low sequence to confirm a breaker block formation around the divergence."
  ],
  "common_mistakes": [
    "Attempting directional breakouts or expansions on the day preceding CPI, when the market is likely to produce a Seek and Destroy / indecision profile instead.",
    "Ignoring the economic calendar and misclassifying a CPI-driven indecision day as a trending profile, leading to failed breakout entries.",
    "Taking entries before the CPI release rather than waiting for post-release confirmation.",
    "Placing stops directly above a breaker block during CPI volatility instead of on high resistance liquidity (a high that ran another high).",
    "Entering blindly on an SMT divergence without waiting for displacement or a structural setup to confirm the reversal."
  ],
  "trading_implication": "CPI is a high-impact event that suppresses clean directional delivery beforehand and produces sharp volatility on release. Daily Profiles advises that the preceding session typically lacks expansion, making directional trades low-probability; if traded, the preferred approach is fading moves back into the established London or Asia range, targeting equilibrium (0.5 level) rather than breakouts. ICT advises avoiding entries before the release and waiting for post-CPI SMT divergences between correlated assets. Due to wider ranges, place stops above high resistance liquidity rather than directly above the breaker block, target equal lows or prior liquidity pools, and use lower time frame (1-minute) entries on retracements into fair value gaps or order blocks to achieve a minimum 2R.",
  "merge_notes": "The two sources frame CPI on different timelines: Daily Profiles focuses on the day before CPI as an indecision/Seek and Destroy profile to fade within established ranges, while ICT focuses on post-release execution via SMT divergence, breaker blocks, and liquidity sweeps at 8:30 ET. Both treat CPI as high-impact and caution against pre-release directional entries, but their actionable setups occur at distinct moments and are complementary rather than conflicting.",

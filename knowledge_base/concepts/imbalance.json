{
  "global_card_id": "imbalance",
  "global_canonical": "Imbalance",
  "type": "merged_concept",
  "school": "SMC",
  "aliases": [],
  "definition": "A condition where buying or selling pressure significantly outweighs the other, often seen as a fair value gap (FVG), representing an area of inefficiency. Imbalances attract price retracement and strengthen support/resistance levels.",
  "definition_per_source": {
    "SMC-Indicator-Supplement": "A condition where buying or selling pressure significantly outweighs the other, often seen as a fair value gap (FVG), representing an area of inefficiency. Imbalances attract price retracement and strengthen support/resistance levels."
  },
  "identification_rules": [
    "A fair value gap (three-candle pattern with non-overlapping wicks) indicates an imbalance.",
    "In an uptrend, a bullish FVG signals buy-side imbalance; in a downtrend, a bearish FVG signals sell-side imbalance.",
    "Demand or supply zones created with an accompanying FVG (imbalance) are considered stronger than those without."
  ],
  "common_mistakes": [
    "Treating a break of a swing level without an associated imbalance as a valid change of character.",
    "Failing to distinguish between major swings with imbalance and minor swings without, leading to incorrect reversal signals."
  ],
  "trading_implication": "Imbalances act as support or resistance; price often returns to fill the gap, providing entry opportunities. A break of a level that created an imbalance signals a significant momentum shift and potential reversal. Imbalances also indicate institutional activity and liquidity voids.",
  "merge_notes": null,

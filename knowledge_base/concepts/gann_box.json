{
  "global_card_id": "gann_box",
  "global_canonical": "Gann Box",
  "type": "merged_concept",
  "school": "ICT",
  "aliases": [],
  "definition": "A charting tool drawn from the top to the bottom of an impulse move that broke previous market structure. It divides the move into equal halves, creating a Premium and Discount Array (PD array) where the upper half represents premium (overpriced) zones and the lower half represents discount (underpriced) zones for directional entry bias.",
  "definition_per_source": {
    "SMC-Supplement-PLv-X125": "A charting tool drawn from the top to the bottom of an impulse move that broke previous market structure. It divides the move into equal halves, creating a Premium and Discount Array (PD array) where the upper half represents premium (overpriced) zones and the lower half represents discount (underpriced) zones for directional entry bias."
  },
  "identification_rules": [
    "Identify an impulse move that has broken previous market structure (a prior swing high or swing low).",
    "Select the Gann Box tool from the Gann and Fibonacci tools menu (described as the third box down on the left-hand toolbar).",
    "Draw the Gann Box from the top of the impulse move to the bottom of the impulse move.",
    "The upper half of the resulting box is the premium zone; the lower half is the discount zone.",
    "For bullish setups, confirm that the pullback entry point falls within the lower (discount) half of the box.",
    "For bearish setups, confirm that the retracement entry point falls within the upper (premium) half of the box."
  ],
  "common_mistakes": [
    "Drawing the Gann Box on a move that did not break previous market structure, making the PD array irrelevant.",
    "Using the Gann Box in isolation without confluence from hidden divergences and trend line confirmation.",
    "Confusing premium and discount zones — attempting to buy in the premium half or sell in the discount half, which is counter to the intended directional bias."
  ],
  "trading_implication": "The Gann Box provides directional entry bias by classifying price zones as premium or discount. In an uptrend, when price pulls back into the discount (lower) half of the PD array, it signals a favorable buy zone. In a downtrend, when price retraces into the premium (upper) half, it signals a favorable sell zone. This tool is used in confluence with hidden divergences and trend lines to build high-probability trade setups targeting the previous swing high (for longs) or previous swing low (for shorts).",
  "merge_notes": null,

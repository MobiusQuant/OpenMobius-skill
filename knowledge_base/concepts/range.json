{
  "global_card_id": "range",
  "global_canonical": "Range",
  "type": "merged_concept",
  "school": "ICT",
  "aliases": [
    "Equilibrium Range",
    "Price Range"
  ],
  "definition": "A price zone defined by a prominent swing high to swing low, divided at the 0.5 Fibonacci level (equilibrium) into a premium half (upper) and a discount half (lower). Used to locate PD arrays for entries and to assess risk-to-reward favorability.",
  "definition_per_source": {
    "Education - ICT (Updated)": "A price zone defined by a prominent swing high to swing low, divided at the 0.5 Fibonacci level (equilibrium) into a premium half (upper) and a discount half (lower). Used to locate PD arrays for entries and to assess risk-to-reward favorability."
  },
  "identification_rules": [
    "Locate the most prominent swing high and swing low in the area and draw a Fibonacci or gone box from high to low.",
    "Mark the 0.5 Fibonacci level as equilibrium; price above 0.5 is premium, price below 0.5 is discount.",
    "When price expands to a new high or low, extend the range to track the new extreme (ranges are expanding).",
    "Recognize multiple nested ranges: each new swing high-to-low or low-to-high leg creates an additional range within the prior one.",
    "After a displacement move, mark a new range from the displacement high to displacement low to find fresh premium/discount zones."
  ],
  "common_mistakes": [
    "Assuming only one range exists in price action when multiple nested ranges form as price expands.",
    "Entering at equilibrium instead of deeper discount/premium, accepting only 1R risk-to-reward.",
    "Failing to update the range when price establishes a new swing high or low."
  ],
  "trading_implication": "Ranges define where risk-to-reward is favorable: long entries are sought from PD arrays in discount, short entries from PD arrays in premium. Entering at equilibrium yields only 1R to the opposite extreme, whereas deeper discount/premium entries produce higher R multiples (e.g., 3.43R via OTE versus 1.6R at equilibrium). Each new swing creates a new range, so analysts must continuously remap ranges as price expands and look for PD arrays (fair value gaps, order blocks, OTE) within the appropriate half relative to bias.",
  "merge_notes": null,

{
  "global_card_id": "inefficiency",
  "global_canonical": "Inefficiency",
  "type": "merged_concept",
  "school": "SMC",
  "aliases": [],
  "definition": "A price imbalance where orders remain unfilled, often appearing as a fair value gap: a three-candlestick pattern with non-overlapping wicks between the first and third candles. This inefficiency acts as a liquidity void that price commonly retraces to fill before continuing the trend. Inside bars may require a four-candle sequence.",
  "definition_per_source": {
    "SMC-Indicator-Supplement": "A price imbalance where orders remain unfilled, often appearing as a fair value gap: a three-candlestick pattern with non-overlapping wicks between the first and third candles. This inefficiency acts as a liquidity void that price commonly retraces to fill before continuing the trend. Inside bars may require a four-candle sequence."
  },
  "identification_rules": [
    "Locate three consecutive candles (four if the first is an inside bar, using the mother candle’s extremes).",
    "Check that the wicks of the first and third candles do not overlap; there must be a visible price gap.",
    "For a bullish FVG, the high of the first candle is below the low of the third candle; for a bearish FVG, the low of the first is above the high of the third.",
    "Ensure the FVG is unmitigated—price has not yet traded through the gap zone on subsequent candles.",
    "Confirm the gap forms after a sharp impulsive move, often with a large-bodied middle candle.",
    "Prioritize FVGs that occur after a break of structure or change of character.",
    "In bullish trends, focus on FVGs in the discount zone; in bearish, focus on FVGs in the premium zone.",
    "Give higher priority to FVGs at market extremes (swing highs/lows) and larger gaps."
  ],
  "common_mistakes": [
    "Mistaking an FVG fill as a trend reversal or change of character; fills often represent mitigation, not a shift in direction.",
    "Entering an FVG without confirmation from a break of structure or change of character.",
    "Ignoring higher time frame context, such as overall trend, key levels, or liquidity zones.",
    "Trading a mitigated FVG after price has already returned to fill it.",
    "Taking FVGs in the wrong premium/discount zone for the trend direction.",
    "Failing to adjust candle count for inside bars, leading to inaccurate FVG boundaries.",
    "Assuming all FVGs will be completely filled; some may only partially fill or not at all.",
    "Treating all FVGs with equal priority instead of prioritizing those at market extremes or with larger gaps.",
    "Not checking for unfilled FVGs on the left side of the chart before confirming a change of character.",
    "Relying solely on indicators without understanding underlying price action.",
    "Confusing a fair value gap with a body gap; wick non-overlap is required.",
    "Placing stop losses without considering extreme order blocks or liquidity sweeps, leading to premature stop-outs.",
    "Ignoring inefficiencies in retracement legs, causing missed entries when price fails to reach extreme order blocks."
  ],
  "trading_implication": "Inefficiencies act as liquidity voids that price tends to return to and fill, offering high-probability entry zones in the direction of the dominant trend. Traders use unmitigated fair value gaps after a break of structure or change of character, entering at the gap when price retraces. In bullish markets, buy FVGs in discount zones; in bearish, sell FVGs in premium zones. A gap fill does not guarantee reversal—it often indicates rebalancing before trend continuation. FVGs also validate order blocks and strengthen supply/demand zones.",
  "merge_notes": null,

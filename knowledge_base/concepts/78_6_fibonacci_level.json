{
  "global_card_id": "78_6_fibonacci_level",
  "global_canonical": "78.6% Fibonacci Level",
  "type": "merged_concept",
  "school": "Indicator Based",
  "aliases": [
    "0.786",
    "0.786 level",
    "786 Fibonacci level",
    "786 Fibonacci retracement level",
    "786 level",
    "0.786 Fibonacci level",
    "786 retracement level"
  ],
  "definition": "A deep Fibonacci retracement level at 78.6% of a swing move (point A to point B), used for trend continuation entries via limit orders. The stop-loss is placed just beyond point A and the target at point B, yielding approximately 1:3 risk-to-reward. Works best on instruments prone to deep pullbacks, such as gold. Price often reacts within a single pip of this level.",
  "definition_per_source": {
    "SMC-Supplement-PLb0LJvd-CX1wZ": "A deep Fibonacci retracement level at 78.6% of a swing move (point A to point B), used for trend continuation entries via limit orders. The stop-loss is placed just beyond point A and the target at point B, yielding approximately 1:3 risk-to-reward. Works best on instruments prone to deep pullbacks, such as gold. Price often reacts within a single pip of this level."
  },
  "identification_rules": [
    "Identify a clear trend with higher highs and higher lows (uptrend) or lower highs and lower lows (downtrend).",
    "Locate the most recent impulsive move from point A to point B in the direction of the trend.",
    "Apply the Fibonacci retracement tool from point A to point B and mark the 0.786 level.",
    "Confirm the higher time frame market structure supports the trade direction and that price has room to reach the target before encountering a major opposing supply or demand zone.",
    "Place a buy limit (uptrend) or sell limit (downtrend) at the 0.786 level, offset by the spread size to account for price reacting within a pip of the level.",
    "Set the stop-loss a couple of pips below point A (longs) or above point A (shorts).",
    "Set the take-profit target at point B, producing approximately 1:3 risk-to-reward.",
    "If price extends the impulsive move further before pulling back, readjust the retracement tool to fit the latest price action."
  ],
  "common_mistakes": [
    "Applying the setup when there is no clearly trending market, violating the trend continuation requirement.",
    "Ignoring higher time frame market structure — entering when price has already tapped or is approaching a major opposing supply or demand zone can lead to reversals.",
    "Failing to account for spread: price often reacts within a single pip of the 0.786 level, so orders must be offset by the spread size or a tight-spread broker must be used.",
    "Using the setup on instruments that do not exhibit deep pullbacks, reducing effectiveness since price never reaches the 0.786 level.",
    "Not readjusting the retracement tool when the impulsive move extends further before pulling back.",
    "Mistakenly using the setup for reversal trades instead of trend continuation."
  ],
  "trading_implication": "Exploits deep pullbacks where the market grabs liquidity before resuming the trend. A limit order at the 0.786 level with a stop beyond the swing origin yields roughly 1:3 risk-to-reward, so one winner offsets three losers. Before entering, verify higher time frame structure aligns with the trade direction and no major opposing zone blocks the target. In an uptrend, price has higher probability of retesting the swing high than breaking below the swing low. Strictly a trend continuation setup; avoid in ranging or unclear conditions.",
  "merge_notes": null,

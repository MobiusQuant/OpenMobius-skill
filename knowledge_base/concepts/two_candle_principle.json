{
  "global_card_id": "two_candle_principle",
  "global_canonical": "两根原则",
  "type": "merged_concept",
  "school": "Indicator Based",
  "aliases": [
    "两根K线确认",
    "两根确认组"
  ],
  "definition": "通用线系统中的破土确认法则：同级别EMA60被一根实体K线破坏后，必须由第二根放量K线站稳两根均线（EMA20与EMA60）才算有效破土，单根确认不足以成立。",
  "definition_per_source": {
    "Teach-Wuyuan": "通用线系统中的破土确认法则：同级别EMA60被一根实体K线破坏后，必须由第二根放量K线站稳两根均线（EMA20与EMA60）才算有效破土，单根确认不足以成立。"
  },
  "identification_rules": [
    "第一根：一根实体K线有效破坏同级别EMA60，构成破土信号线。",
    "第二根：紧随其后需出现一根带放量的K线，把价格站稳并上穿（或下穿）EMA20与EMA60两根均线，方算有效。",
    "若第二根K线被阴包或阳包反向收回，则判定为震荡组，破土不成立，不可顺势追单。",
    "确认成立后不直接进场，需等价格回踩同级别均线（ST二测）再入场，止损放在破土线前一根的最低点或最高点。"
  ],
  "common_mistakes": [
    "自作聪明只用一根K线确认就进场做单，止损易被插针扫掉后价格再反向运行。",
    "在均线粘合的震荡行情里硬做，空间小、做得很累且盈亏比差。",
    "破土后不等回踩直接追单，导致止损被迫放得过大、盈亏比变差。",
    "第二根K线被反包形成震荡组却仍当作有效破土去顺势追单。"
  ],
  "trading_implication": "两根原则用于过滤假破土，避免在仅一根K线确认时进场被插针扫损。讲师强调非农等高波动时段做市商常急速刺破支撑后反向运行，单根确认者会被直接扫掉止损后再反向运行而白亏。两根放量站稳确认后再等回踩入场，可获得更小止损、更优盈亏比，并能顺势持有较大一段利润，直到穿线离场。",
  "merge_notes": null,

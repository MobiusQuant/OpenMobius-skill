{
  "global_card_id": "21_period_moving_average",
  "global_canonical": "21-Period Moving Average",
  "type": "merged_concept",
  "school": "Indicator Based",
  "aliases": [
    "21 MA",
    "21 moving average",
    "21 period moving average"
  ],
  "definition": "A short-term smoothed moving average set to 21 periods, used as the primary dynamic support/resistance level for trend continuation entries. Price rejections off the 21 MA, especially when aligned with Fibonacci retracement levels, signal high-probability entries in the direction of the prevailing trend.",
  "definition_per_source": {
    "SMC-Supplement-PLv-X125": "A short-term smoothed moving average set to 21 periods, used as the primary dynamic support/resistance level for trend continuation entries. Price rejections off the 21 MA, especially when aligned with Fibonacci retracement levels, signal high-probability entries in the direction of the prevailing trend."
  },
  "identification_rules": [
    "Plot a smoothed moving average with period 21 on the chart alongside the 50 and 200 moving averages.",
    "Confirm all three moving averages (21, 50, 200) are aligned in the same direction before considering entries off the 21 MA.",
    "In a downtrend (price below the 200 MA), look for price to pull back up to the 21 MA and reject with a candlestick signal such as an engulfing candle or three line strike.",
    "Identify confluence where the 21 MA intersects or converges with a Fibonacci retracement level (especially the 0.382) to confirm the entry zone.",
    "Verify RSI is below the 50 level for shorts (or above 50 for longs) to confirm momentum aligns with the 21 MA rejection direction."
  ],
  "common_mistakes": [
    "Entering a trade off the 21 MA without waiting for a candlestick confirmation signal such as an engulfing candle, three line strike, or zone of multiple wicks.",
    "Taking a 21 MA rejection trade when the 21, 50, and 200 moving averages are not aligned in the same trend direction.",
    "Treating Fibonacci levels as exact prices rather than zones when looking for confluence with the 21 MA.",
    "Attempting to enter on the first pullback when price is still too far from the 21 MA after a steep impulse move, rather than waiting for price to approach the moving average."
  ],
  "trading_implication": "The 21 MA serves as the nearest dynamic support/resistance in a trending market. When price retraces to the 21 MA and a Fibonacci level (particularly the 0.382) converges at the same zone, this confluence provides a high-probability trend continuation entry. The trader targets the previous swing high/low as take profit 1, with additional take profit levels set via Fibonacci extensions using a trailing stop. Steep impulse moves (approximately 90-degree angle) tend to retrace only to the 0.382 level near the 21 MA, while shallower moves (45-degree angle) may retrace deeper to the 0.618.",
  "merge_notes": null,

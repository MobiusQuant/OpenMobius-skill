{
  "card_id": "chanlun__term_aa033cef",
  "type": "merged_concept",
  "canonical_term": "上沿",
  "aliases": [
    "中枢上沿",
    "中枢区间上边界"
  ],
  "school": "缠论",
  "definition": "中枢区间的上边界价格水平线，由前三段笔相互重叠区域的最高边界决定。上沿具有压力作用，股价接近上沿时容易遇阻回落；突破上沿后回踩不破则确认支撑转换。",
  "identification_rules": [
    "确定中枢区间：找到连续三笔相互重叠的区域，该重叠区域的上边界即为上沿。",
    "中枢区间由前三段决定，后续延伸段不改变上沿位置。",
    "在上沿价位画一条水平线，向左右延伸，用于观察历史和未来的压力与支撑转换。",
    "股价从下方接近上沿水平线时，判断为压力位；股价突破上沿后回踩该水平线不跌破，则确认压力转为支撑。"
  ],
  "trading_implication": "上沿是中枢区间提供的关键压力位。实战中，在上沿画水平线可精准判断股价压力，视频中以SOXL和TSLA为例，展示股价多次在上沿处遇阻回落的精准表现。当股价突破上沿后回踩确认不破，则上沿转化为支撑位，可作为买入或持仓依据。中枢上沿与下沿配合使用，能有效框定股价运行的支撑压力区间，是围绕中枢区间进行买卖操作的核心参考。",
  "common_mistakes": [
    "忽略画上沿水平线，仅凭感觉判断压力位，导致判断不精准。",
    "将后续延伸段纳入上沿计算，错误改变了中枢区间范围——上沿由前三段决定，后续段不影响。",
    "混淆上沿的压力与支撑双重角色：未突破时为压力，突破回踩不破后转为支撑，不可一概而论。"
  ],

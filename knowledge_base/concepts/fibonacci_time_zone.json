{
  "global_card_id": "fibonacci_time_zone",
  "global_canonical": "斐波那契时间区/时间周期推演",
  "type": "merged_concept",
  "school": "Indicator Based",
  "aliases": [
    "Fibonacci Time Zones",
    "月线时间推导",
    "飞波纳气时区",
    "飞波纳气时间"
  ],
  "definition": "用斐波那契序列在时间轴上推演变盘节点的工具。时区仅需A、B两点确认启动段即可推至超长周期；时间工具追求精准节点定位。每个节点代表一次方向性变盘信号。",
  "definition_per_source": {
    "Teach-Wuyuan": "用斐波那契序列在时间轴上推演变盘节点的工具。时区仅需A、B两点确认启动段即可推至超长周期；时间工具追求精准节点定位。每个节点代表一次方向性变盘信号。"
  },
  "identification_rules": [
    "时区工具只需锚定起涨A点（如2019年）与第一波顶端B点（如2020年），月份对齐即可向后无限推算节点，中间高低无所谓。",
    "时间工具需精确锚定低点启动点（如2022年10月低点），用于推算近期精准变盘月份，难度更高。",
    "每个斐波那契时间节点都代表一次变盘信号，节点间距随级别后移而逐渐拉长。",
    "判断节点方向遵循前后交替规律：前一段若为上涨，后一段大概率偏下跌；前一段若为下跌，后一段大概率偏上涨。",
    "需考虑滞后性，实际变盘可能比理论节点延后约一个月（如2.618节点处有约一个月延后）。",
    "数字5对应的节点容易形成多头变盘点。"
  ],
  "common_mistakes": [
    "误以为节点必然指向下跌；实际方向由前段涨跌交替规律决定，需逐段对应判断。",
    "时区推算时纠结于中间高低点对齐，实际只需把握启动段两点的月份不差即可。",
    "忽视约一个月的滞后性，导致节点月份判断偏早。",
    "试图用月线级时间推演直接做日内或短线交易，月线一根K线内部分时结构极丰富，无法据此进场。"
  ],
  "trading_implication": "用于预判月线级别等超大周期的方向性变盘时点，而非日内进场。讲师据此推算黄金7-8月变盘、2029年5月超高周期变盘点。月线级变盘幅度通常1500美金起步，500美金只是小水花。时间推演只给出变盘时点与大致方向，需结合前后涨跌交替规律判断方向。实战交易仍需切到日线及以下级别，配合飞波回撤/扩展、EMA60、订单块等确认具体进出场。",
  "merge_notes": null,

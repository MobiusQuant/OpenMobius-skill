{
  "global_card_id": "50_period_exponential_moving_average",
  "global_canonical": "50-period Exponential Moving Average",
  "type": "merged_concept",
  "school": "Indicator Based",
  "aliases": [
    "50 EMA",
    "EMA 50"
  ],
  "definition": "A 50-period Exponential Moving Average plotted on the chart to determine market bias and act as a dynamic reaction level. Price trending above it with higher highs and higher lows signals bullish bias; price breaking below with new lows signals bearish bias. When price repeatedly crosses both sides without a clear trend, it signals to stay out. Price rejections off the 50 EMA, confirmed by candlestick patterns such as engulfing candles, generate entry signals in the direction of the bias.",
  "definition_per_source": {
    "SMC-Supplement-PLb0LJvd-CX1wZ": "A 50-period Exponential Moving Average plotted on the chart to determine market bias and act as a dynamic reaction level. Price trending above it with higher highs and higher lows signals bullish bias; price breaking below with new lows signals bearish bias. When price repeatedly crosses both sides without a clear trend, it signals to stay out. Price rejections off the 50 EMA, confirmed by candlestick patterns such as engulfing candles, generate entry signals in the direction of the bias."
  },
  "identification_rules": [
    "Apply the Exponential Moving Average indicator to the chart with the period set to 50.",
    "Bullish bias is confirmed when price is trending above the 50 EMA and creating new higher highs and higher lows; look only for long entries.",
    "Bearish bias is confirmed when price breaks below the 50 EMA and creates a new low; look only for short entries.",
    "If price continuously crosses the 50 EMA on both sides without a clear trending movement, classify the market as unclear and stay out.",
    "An entry signal occurs when price pulls back to the 50 EMA, rejects it, and prints an engulfing candlestick pattern in the direction of the established bias."
  ],
  "common_mistakes": [
    "Trading against the 50 EMA bias — e.g., going long when price has broken below the 50 EMA or selling when price is trending above it.",
    "Taking trades when price continuously crosses the 50 EMA on both sides without a clear trend, instead of staying out of the market.",
    "Entering on a 50 EMA rejection without waiting for a confirming engulfing candlestick pattern.",
    "Not checking the higher time frame for key levels (demand/supply zones) that may invalidate or limit the trade before entering based on the 50 EMA signal.",
    "Failing to recognize that knowing when not to trade is as important as knowing when to trade."
  ],
  "trading_implication": "The 50 EMA serves as a directional filter in a trading workflow: traders only take long positions when price is above it and short positions when price is below it. Rejections off the 50 EMA combined with engulfing candlestick patterns provide specific entry triggers. When the 50 EMA gives no clear signal, the trader avoids the market entirely. After entry, profit management techniques include multiple targets (1:1 first target, higher time frame key level second target) or trailing the stop-loss below successive swing lows after each break of structure.",
  "merge_notes": null,

{
  "global_card_id": "70_30_rsi_range",
  "global_canonical": "70/30 RSI Range",
  "type": "merged_concept",
  "school": "Indicator Based",
  "aliases": [
    "70 30 range",
    "70/30 Range",
    "7030 Range",
    "RSI 70/30 Zone",
    "Standard RSI Boundaries",
    "secret sauce"
  ],
  "definition": "The standard RSI boundaries at 70 (overbought) and 30 (oversold). Used as a momentum confirmation filter for divergence-based reversals: RSI must first exit the 70–30 range into overbought or oversold territory, then re-enter the normal zone, confirming momentum loss. Only divergences where at least one RSI swing point falls outside the 70–30 range are considered valid. Divergences contained entirely within the range are classified as low probability.",
  "definition_per_source": {
    "SMC-Supplement-PLv-X125": "The standard RSI boundaries at 70 (overbought) and 30 (oversold). Used as a momentum confirmation filter for divergence-based reversals: RSI must first exit the 70–30 range into overbought or oversold territory, then re-enter the normal zone, confirming momentum loss. Only divergences where at least one RSI swing point falls outside the 70–30 range are considered valid. Divergences contained entirely within the range are classified as low probability."
  },
  "identification_rules": [
    "Plot horizontal lines at RSI 70 and RSI 30 on the indicator panel (default period 14) to define the range boundaries.",
    "Confirm RSI has crossed above 70 (overbought) or below 30 (oversold), indicating momentum has reached an extreme.",
    "Wait for RSI to cross back inside the 70–30 range — this re-entry signals that extreme momentum has faded.",
    "For each divergence in a sequence, note whether the RSI peak (uptrend) or trough (downtrend) falls outside or within the 70/30 range.",
    "When a regular divergence is identified, verify at least one of its two RSI swing points is above 70 or below 30; discard divergences where both points remain inside the range.",
    "For bearish setups, the higher-probability signal occurs when consecutive RSI peaks shift from above 70 to within the range while price still makes a higher high.",
    "For bullish setups, the higher-probability signal occurs when consecutive RSI troughs shift from below 30 to within the range while price still makes a lower low.",
    "Mark the first RSI peak (from above 70) or trough (from below 30) that forms after re-entry as the signal point, and map it to the corresponding price candle.",
    "Ignore any divergence that forms while RSI is still outside the 70/30 boundaries, as momentum remains too strong for a reliable reversal signal."
  ],
  "common_mistakes": [
    "Entering reversal trades on the first divergence when RSI peaks are still above 70 or troughs below 30, where momentum remains strong and price continues trending.",
    "Treating all divergences equally without checking whether RSI points are above/below or within the 70/30 range to assess momentum context.",
    "Assuming price will reverse immediately because RSI is overbought or oversold, without waiting for RSI to trade back within the 70/30 range.",
    "Ignoring divergences within the overbought/oversold zone and only reacting to the RSI level itself.",
    "Taking every regular divergence regardless of whether RSI reached overbought or oversold territory, leading to many failed counter-trend trades.",
    "Assuming a regular divergence always means a full trend reversal — many only produce a small pullback before the trend continues.",
    "Trading regular divergences without also requiring a trend line break or market structure confirmation, increasing exposure to counter-trend risk.",
    "Using divergences on lower time frames to anticipate large swing reversals instead of confirming on higher time frames where divergences carry more weight.",
    "Failing to wait for the complete sequence (exit range, re-enter range, form peak/trough) before taking a position.",
    "Not placing a stop loss below the previous swing when entering, exposing the trade to unnecessary risk.",
    "Trading during flat, ranging markets where RSI signals are unreliable instead of waiting for clear trending conditions."
  ],
  "trading_implication": "While RSI remains outside the 70/30 range, the trend retains strength and divergences are premature. The critical shift occurs when RSI re-enters the range after an extreme — this confirms momentum loss and signals a high-probability reversal. After re-entry from above 70, look for short entries; after re-entry from below 30, look for longs. Combine with trend line breaks, market structure (prior swing highs/lows for stop placement), or Heikin Ashi candles to refine entry timing. This filter reduces false signals and improves risk-to-reward outcomes.",
  "merge_notes": null,

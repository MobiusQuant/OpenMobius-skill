{
  "global_card_id": "three_line_strike",
  "global_canonical": "Three Line Strike",
  "type": "merged_concept",
  "school": "Price Action",
  "aliases": [
    "3 Line Strike",
    "Three-Line Strike"
  ],
  "definition": "A candlestick pattern consisting of three consecutive candles closing in one direction followed by a single engulfing candle in the opposite direction. The fourth candle opens in the same direction as the prior three but closes opposite, with its body fully covering all three previous candle bodies. It signals a potential price pivot or reversal entry point and serves as a final confirmation trigger when aligned with other confluences at key technical levels.",
  "definition_per_source": {
    "SMC-Supplement-PLv-X125": "A candlestick pattern consisting of three consecutive candles closing in one direction followed by a single engulfing candle in the opposite direction. The fourth candle opens in the same direction as the prior three but closes opposite, with its body fully covering all three previous candle bodies. It signals a potential price pivot or reversal entry point and serves as a final confirmation trigger when aligned with other confluences at key technical levels."
  },
  "identification_rules": [
    "Identify three consecutive candles that close in the same direction (e.g., three bullish or three bearish candles in a row).",
    "The fourth candle must open in the same direction as the prior three but close in the opposite direction, with its body engulfing all three previous candle bodies.",
    "Validate that the pattern occurs at a significant technical level such as a Fibonacci retracement, moving average, round number, psychological level, or support/resistance zone.",
    "The pattern is valid as an entry trigger only after other confluences are confirmed (e.g., divergence, break of market structure, moving average retest, RSI conditions).",
    "Enter the trade on the close of the engulfing (fourth) candle, not before it has fully closed."
  ],
  "common_mistakes": [
    "Using the Three Line Strike as a standalone entry signal without confluence from key levels (Fibonacci, round numbers, support/resistance) or indicators (RSI divergence, moving averages).",
    "Entering too early before the engulfing candle has fully closed, risking a false signal.",
    "Ignoring the broader trend context and higher time frame analysis when trading this pattern on lower time frames.",
    "Entering a trend continuation trade without waiting for a confirming candle formation like the Three Line Strike, risking a stop-out if price temporarily moves against the position."
  ],
  "trading_implication": "The Three Line Strike identifies price pivot points where a retracement completes and the dominant trend resumes. It serves as the final confluence to time a precise entry after higher-probability conditions are established—such as RSI divergence, break of market structure, moving average retest, or alignment with Fibonacci levels and round numbers. Traders enter at the close of the engulfing candle and target levels like the 200-period moving average, converting a high-confluence setup into an actionable entry rather than using it standalone.",
  "merge_notes": null,

{
  "global_card_id": "61_8_fibonacci_level",
  "global_canonical": "61.8% Fibonacci Level",
  "type": "merged_concept",
  "school": "Price Action",
  "aliases": [
    "0.618",
    "618 Fib level",
    "618 level",
    "golden ratio retracement",
    "golden ratio retracement level"
  ],
  "definition": "The 61.8% Fibonacci retracement level, derived from the golden ratio, used as a precise entry point in reversal setups. After a double bottom (or double top) confirms and the neckline breaks, the Fibonacci tool is applied from the swing low to the swing high of the confirmed move. A buy limit order is placed at the 0.618 retracement level, allowing a tighter stop-loss below the swing low compared to entering at the neckline break.",
  "definition_per_source": {
    "SMC-Supplement-PLb0LJvd-CX1wZ": "The 61.8% Fibonacci retracement level, derived from the golden ratio, used as a precise entry point in reversal setups. After a double bottom (or double top) confirms and the neckline breaks, the Fibonacci tool is applied from the swing low to the swing high of the confirmed move. A buy limit order is placed at the 0.618 retracement level, allowing a tighter stop-loss below the swing low compared to entering at the neckline break."
  },
  "identification_rules": [
    "Wait for a completed double bottom (or double top) pattern at a major level of structure, confirmed by a neckline break, before applying the Fibonacci tool.",
    "Apply the Fibonacci retracement tool from the actual swing low wick (start of the move) to the swing high (neckline break point / end of the confirmed move).",
    "Identify the 0.618 retracement level, which appears as a horizontal line at 61.8% of the distance between the swing low and swing high measured from the high downward, as the precise entry price for a buy limit (or sell limit in bearish setups).",
    "Confirm the setup exists within a higher time frame context where a major level of structure supports the reversal direction.",
    "Place the stop-loss just below the swing low of the pattern."
  ],
  "common_mistakes": [
    "Entering at the neckline break instead of waiting for the 0.618 pullback, resulting in an excessively large stop-loss distance.",
    "Using the 0.618 level without first confirming a valid double bottom or double top pattern and neckline break, leading to premature entries.",
    "Applying the Fibonacci tool incorrectly by not measuring from the actual swing low wick to the swing high of the confirmed move.",
    "Trading the 0.618 reversal entry without first identifying a major level of structure on the higher time frame for directional bias.",
    "Not placing the stop-loss below the swing low, which is required regardless of the Fibonacci entry level."
  ],
  "trading_implication": "The 0.618 level provides a precise, cost-efficient entry after a reversal pattern completes on a lower time frame at a major structural level identified on a higher time frame. Entering at this retracement rather than at the neckline break significantly reduces stop-loss distance, improving the risk-to-reward ratio. Half the position can be closed at 2:1 R:R to reach break even, with the remainder targeting the next higher time frame structure level (e.g., supply or demand zone).",
  "merge_notes": null,

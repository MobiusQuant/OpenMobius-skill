{
  "global_card_id": "swing_trade",
  "global_canonical": "Swing Trade",
  "type": "merged_concept",
  "school": "General",
  "aliases": [
    "set it and forget it",
    "swing trading"
  ],
  "definition": "A trading style where positions are held for hours to days, typically 12–17 hours, using Fibonacci retracement levels on 5-minute or higher time frame charts. Entries are placed in advance as limit orders, targeting the full retracement back to the impulse move's origin, and left to execute without active management.",
  "definition_per_source": {
    "SMC-Supplement-PLv-X125": "A trading style where positions are held for hours to days, typically 12–17 hours, using Fibonacci retracement levels on 5-minute or higher time frame charts. Entries are placed in advance as limit orders, targeting the full retracement back to the impulse move's origin, and left to execute without active management."
  },
  "identification_rules": [
    "Identify a strong impulse move (big momentum swing) on the chart and apply the Fibonacci retracement tool from the swing low to the swing high (or vice versa).",
    "Place a limit order at the 0.5 Fibonacci retracement level in advance, so the order executes automatically when price reaches that zone.",
    "Set the take-profit target at the origin of the impulse move (the previous swing high for longs or swing low for shorts).",
    "Set the stop loss at the 0.764 Fibonacci level when entering at the 0.5 retracement level.",
    "Confirm the trade is not a higher time frame retracement by checking that price stalls and consolidates at the Fibonacci level rather than blowing through it."
  ],
  "common_mistakes": [
    "Entering too early as price is still moving toward the 0.5 Fibonacci level instead of waiting for price to stall, consolidate, and confirm at that level.",
    "Failing to recognize that a retracement on the current time frame could actually be a retracement on a higher time frame, leading to unexpected deeper pullbacks.",
    "Treating the strategy as a scalping approach with quick entries and exits instead of holding positions for the full 12–17 hour duration.",
    "Not placing orders in advance as limit orders, causing missed entries when price passes through the target level."
  ],
  "trading_implication": "Swing trades target larger moves than scalping, with positions lasting approximately 12–17 hours. The approach is set-it-and-forget-it: place the order, stop loss, and take profit in advance, then walk away. These trades yield roughly 1:2 risk-to-reward ratios, meaning one winning trade covers two losing trades and still breaks even. The strategy works on forex pairs (e.g., AUDUSD on 5-minute charts) and cryptocurrencies (e.g., BTCUSDT on 1-hour charts) for buying dips during bull runs using Fibonacci retracement levels.",
  "merge_notes": null,

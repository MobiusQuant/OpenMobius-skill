{
  "global_card_id": "heikin_ashi_candles",
  "global_canonical": "Heikin Ashi Candles",
  "type": "merged_concept",
  "school": "Price Action",
  "aliases": [
    "HA Candles",
    "Heiken Ashi",
    "Heikin Ashi"
  ],
  "definition": "A modified candlestick type that averages price data to smooth trends and filter noise. Used as an entry trigger after divergence is identified: a bearish Heikin Ashi candle with no upper wick signals strong selling momentum, while the first color-change candle signals a potential exit.",
  "definition_per_source": {
    "SMC-Supplement-PLv-X125": "A modified candlestick type that averages price data to smooth trends and filter noise. Used as an entry trigger after divergence is identified: a bearish Heikin Ashi candle with no upper wick signals strong selling momentum, while the first color-change candle signals a potential exit."
  },
  "identification_rules": [
    "Switch chart to Heikin Ashi candle type after identifying a divergence and loss of momentum on the RSI.",
    "A bearish Heikin Ashi candle with no upper wick (flat top) confirms strong selling momentum and serves as the entry signal for a short position.",
    "A bullish Heikin Ashi candle (first candle that changes color from bearish to bullish) signals the end of selling momentum and serves as the exit signal.",
    "The entry is placed at the close of the no-wick bearish Heikin Ashi candle, with a stop loss set above the recent swing high or rejection point."
  ],
  "common_mistakes": [
    "Entering on any bearish Heikin Ashi candle rather than specifically waiting for one with no upper wick, which is the confirmed strong momentum signal.",
    "Using Heikin Ashi candles in isolation without first confirming a divergence and structural failure (e.g., failure to make a higher high) on the RSI."
  ],
  "trading_implication": "Heikin Ashi candles are used as a timing tool after a divergence setup is confirmed. Once the RSI shows loss of momentum (e.g., a lower high on RSI during an uptrend) and price fails to make a new higher high, the trader switches to Heikin Ashi candles to find a precise short entry. The no-upper-wick bearish candle provides the entry trigger. Trades can be managed by holding until the first bullish color-change candle appears, or by using a fixed 1:2 risk-to-reward ratio with a stop loss above the rejection point.",
  "merge_notes": null,

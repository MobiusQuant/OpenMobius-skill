{
  "global_card_id": "value_area_high",
  "global_canonical": "Value Area High",
  "type": "merged_concept",
  "school": "Order Flow",
  "aliases": [
    "VAH",
    "价值区高点(VAH)",
    "高成交量峰值上沿"
  ],
  "definition": "价值区高点是 SVP/VRVP 成交量分布中价值区域的上沿，即高成交量峰值的顶部价位，通常出现在盘整区间的顶部，与下沿 VAL 和平衡点 POC 共同界定价格的价值区间。",
  "definition_per_source": {
    "Teach-Wuyuan": "价值区高点是 SVP/VRVP 成交量分布中价值区域的上沿，即高成交量峰值的顶部价位，通常出现在盘整区间的顶部，与下沿 VAL 和平衡点 POC 共同界定价格的价值区间。"
  },
  "identification_rules": [
    "打开 SVP（交易时间段成交量分布图），系统会自动按交易时段锚定并划分正态分布区间。",
    "在划分出的成交量分布区间中，取上沿的高成交量峰值价位作为 VAH，对应区间顶部。",
    "VAH 与 VAL（区间底部低点）大概率出现在整个盘整区间的顶底两端，中间的平衡价值点即 POC。",
    "可缩放图表查看不同交易时段，若多个时段在同一价位重叠（三线共振），该 VAH/支撑更强。"
  ],
  "common_mistakes": [
    "价格刚一触及 VAH 就直接进场，未等收线确认破坏，应等收盘破坏才判断进入下一区间。",
    "听到回测就脑子一热逆势做空，忽略整体多头趋势，结果价格继续拉涨后才下跌而被套。",
    "忽视 SVP 区间的动态分布特性，价格常去回补上一个区间的 VAH/POC，导致误判当前支撑阻力所在区间。"
  ],
  "trading_implication": "VAH 标记价值区上沿。价格突破区间后，所有突破时段都要对之前的 VAH 进行回测，回测 VAH 不破时该位置变成支阻互换位，可在此做多。讲师强调用流动性看 VAH 无需切换级别，5 分钟与 1 小时看到的价位基本一致，但需结合收线确认与顺势方向，避免在多头趋势中逆势做空。",
  "merge_notes": null,

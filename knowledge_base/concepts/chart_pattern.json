{
  "global_card_id": "chart_pattern",
  "global_canonical": "Chart Pattern",
  "type": "merged_concept",
  "school": "Price Action",
  "aliases": [
    "Auto Chart Pattern Indicator",
    "All Chart Patterns Indicator"
  ],
  "definition": "Chart patterns are recognizable formations created by price movements—such as triangles, head and shoulders, and wedges—often built by trendlines connecting pivot highs and lows. They mark areas of support and resistance and frequently precede strong directional breakouts, especially after price compression. They can be drawn manually from pivots or detected automatically via a TradingView indicator that also projects breakout targets.",
  "definition_per_source": {
    "SMC-Strong-Weak-Supplement (Auto Chart Pattern Indicator)": "A TradingView built-in indicator that automatically detects common chart patterns (e.g., head and shoulders, wedges) on price charts and projects price targets upon pattern breakouts.",
    "SMC-Strong-Weak-Supplement (Chart Pattern)": "Formations created by price movements, such as triangles formed by trendlines connecting pivot highs and lows. They indicate support and resistance areas and often lead to strong breakouts when price breaks the pattern boundaries, particularly after a period of compression."
  },
  "identification_rules": [
    "Identify pivot highs and lows that mark significant turning points (e.g., pivot length of 20 candles) — the Chart Pattern source emphasizes manual pivot identification.",
    "Connect at least two pivot highs with a trendline to define sloping resistance, and draw a horizontal support line aligned with multiple pivot lows.",
    "Observe price moving within converging lines (e.g., lower highs and flat lows forming a descending triangle).",
    "Confirm a valid breakout/breakdown only when price closes beyond the pattern boundary, ideally with increased momentum.",
    "Alternatively, use TradingView's 'All Chart Patterns' indicator: search it in the indicators tab and add it to the chart — the Auto Indicator source provides this automated route.",
    "In the indicator settings, choose desired patterns (e.g., double top, double bottom) and optionally enable 'in progress' to show forming patterns.",
    "Set visibility to 'all' to display every pattern or 'most recent' for only the latest; toggle price target lines on/off.",
    "With the indicator, patterns appear automatically as shaded zones with labels and horizontal target lines."
  ],
  "common_mistakes": [
    "Misidentifying random price swings as a valid pattern; ensure multiple pivot points confirm the trendlines.",
    "Entering a trade before the breakout is confirmed by a close beyond the pattern boundary.",
    "Ignoring the compression phase—breakout reliability increases when price coils tightly before the break.",
    "Relying solely on auto-detected patterns without additional technical confirmation.",
    "Enabling all patterns and in-progress patterns simultaneously, causing chart clutter and analysis paralysis."
  ],
  "trading_implication": "Chart patterns signal potential large directional moves and are best used to anticipate and trade breakouts. The Chart Pattern source stresses manual analysis: a descending triangle with tightening range suggests a strong downside breakout once support breaks, with pattern boundaries used to set entries and stops, entering only after a confirmed close beyond the boundary. The Auto Chart Pattern Indicator source offers a faster, automated alternative—detecting patterns and projecting breakout targets—but advises combining it with other technical tools (trend analysis, support/resistance) to raise trade probabilities and avoid over-reliance on auto-detection.",
  "merge_notes": "The two sources are classified under different schools (Price Action vs. Indicator Based) and represent complementary approaches to the same concept: one builds patterns manually from pivots and emphasizes compression and confirmed closes; the other automates detection via a TradingView indicator with projected targets and configuration options. They do not conflict but differ in method and emphasis.",

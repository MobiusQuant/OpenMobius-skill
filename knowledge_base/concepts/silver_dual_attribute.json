{
  "global_card_id": "silver_dual_attribute",
  "global_canonical": "白银双重属性",
  "type": "merged_concept",
  "school": "General",
  "aliases": [
    "白银半工业半避险属性",
    "白银工业+避险双重属性"
  ],
  "definition": "白银兼具半工业与半避险属性。黄金为纯抗通胀避险品种，经济越差越涨；白银因经济走弱时工业需求下降而被拖累，故避险时涨幅小、永远比黄金弱一节，大跌时跟跌但跌幅小于黄金。",
  "definition_per_source": {
    "Teach-Wuyuan": "白银兼具半工业与半避险属性。黄金为纯抗通胀避险品种，经济越差越涨；白银因经济走弱时工业需求下降而被拖累，故避险时涨幅小、永远比黄金弱一节，大跌时跟跌但跌幅小于黄金。"
  },
  "identification_rules": [
    "判断白银是否同步上涨：当美国经济数据走弱（如非农疲软）黄金大涨时，若白银涨幅明显偏小或滞涨，即体现其工业属性拖累避险属性。",
    "经济强、风险资产（美股/加密货币）上涨时工业需求增加，白银价格倾向被抬升甚至抗跌，反映工业属性。",
    "大跌行情中观察跌幅对比：白银跟随黄金下跌一天后，后续跌幅小于黄金，即为双重属性带来的相对抗跌特征。",
    "结构上白银相对偏弱：黄金运行于日线均线之上、上方无均线阻力可持续创高，而白银被均线上下压制于区间内震荡，相对弱一节。"
  ],
  "common_mistakes": [
    "误以为工业需求降低会推升白银价格——讲师强调需求消失则无人接盘，价格反而下跌，并非简单的供需反向逻辑。",
    "盲目跟随市场主流看白银涨幅大、上200甚至208的乐观预期，忽视其相对偏弱、需补黄金涨幅的本质。",
    "把白银的避险上涨等同于黄金，忽略其涨幅永远比黄金小一节。"
  ],
  "trading_implication": "用于解释白银相对黄金的相对强弱：避险驱动时白银涨幅小、不宜对其涨幅过度乐观；经济转好或风险资产上涨时白银工业需求回升可获支撑。整体白银永远比黄金弱一节、需补黄金涨幅，做多预期应低于黄金；大跌中白银相对抗跌但仍会跟跌一天。讲师借此反驳市场看白银上200的主流乐观观点，认为黄金反而偏强。",
  "merge_notes": null,

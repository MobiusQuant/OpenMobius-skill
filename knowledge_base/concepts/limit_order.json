{
  "global_card_id": "limit_order",
  "global_canonical": "Limit Order",
  "type": "merged_concept",
  "school": "Risk Management",
  "aliases": [
    "order placed in advance",
    "pending order"
  ],
  "definition": "A pending order placed at a specific Fibonacci retracement level (typically between 0.5 and 0.618, within the Gold Zone) that executes automatically when price retraces to it after a confirmed Break of Structure. Enables precise, pre-planned entries at predetermined levels without requiring the trader to monitor the chart continuously. If price does not retrace to the limit order level, the order simply does not fill and the trader waits for the next setup.",
  "definition_per_source": {
    "SMC-Supplement-PLv-X125": "A pending order placed at a specific Fibonacci retracement level (typically between 0.5 and 0.618, within the Gold Zone) that executes automatically when price retraces to it after a confirmed Break of Structure. Enables precise, pre-planned entries at predetermined levels without requiring the trader to monitor the chart continuously. If price does not retrace to the limit order level, the order simply does not fill and the trader waits for the next setup."
  },
  "identification_rules": [
    "Confirm a Break of Structure: a candle must close above a previous swing high (for longs) or below a previous swing low (for shorts), showing clear one-directional impulse momentum.",
    "Wait for price to begin retracing after the break before drawing the Fibonacci Retracement tool.",
    "Draw the Fibonacci Retracement from the start to the end of the impulse move (wick to wick), bottom to top for longs or top to bottom for shorts.",
    "Place the limit order at the 0.5 to 0.618 retracement level within the Gold Zone, with the 0.618 level providing the best risk-to-reward ratio.",
    "Set the stop-loss between the 0.618 and 1.0 Fibonacci level (above the swing high for shorts, below the swing low for longs).",
    "Set the take-profit at the previous swing high (for longs) or previous swing low (for shorts).",
    "The limit order direction must align with the current trend direction on the trading timeframe.",
    "Only place limit orders during high-volume sessions (London open to New York close) to avoid fake-outs on low-volume noise."
  ],
  "common_mistakes": [
    "Entering at the 0.5 retracement instead of the 0.618, which reduces the risk-to-reward ratio.",
    "Not placing a stop-loss at or near the 1.0 Fibonacci level when using a limit order, leaving the trade unprotected.",
    "Placing a limit order before a candle has closed beyond the previous swing high or low, entering without a confirmed Break of Structure.",
    "Drawing the Fibonacci Retracement tool immediately after the break instead of waiting for a retracement to begin.",
    "Drawing the Fibonacci tool incorrectly by not including the full wick-to-wick range of the impulse move.",
    "Placing limit orders during choppy, sideways markets where there is no clear impulse move or structure break.",
    "Using limit orders during major news events when large candles can ignore all Fibonacci levels.",
    "Trading outside high-volume sessions (London to New York) where fake-outs are common and limit orders get triggered on noise.",
    "Placing a limit order against the current trend direction rather than in the direction of the established trend.",
    "Expecting every limit order to fill—sometimes momentum carries price past the break of structure without retracing to the entry level.",
    "Entering the trade as price is still traveling toward the retracement level instead of having the order placed in advance, risking a premature entry.",
    "Failing to recognize that the retracement could belong to a higher time frame move, leading to an early and incorrect entry.",
    "Forcing a trade when the limit order is not hit instead of accepting the miss and moving on to the next setup."
  ],
  "trading_implication": "Limit orders enable a 'set it and forget it' approach to Fibonacci retracement entries. By pre-setting entry, stop-loss, and take-profit, the trader removes emotional decision-making and avoids missing entries when price moves quickly through the retracement level. Targeting the 0.618 level yields approximately 1:1.5 to 1:2 risk-to-reward ratios. This method works for both scalping (multiple rapid Break of Structure setups) and swing trades. Missing a trade because price does not retrace is preferable to taking a suboptimal entry at a shallower level.",
  "merge_notes": null,

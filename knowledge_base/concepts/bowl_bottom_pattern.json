{
  "global_card_id": "bowl_bottom_pattern",
  "global_canonical": "碗底形态",
  "type": "merged_concept",
  "school": "Price Action",
  "aliases": [
    "圆弧底(碗底)",
    "碗底+碗口形态"
  ],
  "definition": "一种超长周期的圆弧形底部反转形态，价格用极长时间走出弧形碗状底部（碗底），再形成碗口并最终突破前高，预示趋势由跌转涨。",
  "definition_per_source": {
    "Teach-Wuyuan": "一种超长周期的圆弧形底部反转形态，价格用极长时间走出弧形碗状底部（碗底），再形成碗口并最终突破前高，预示趋势由跌转涨。"
  },
  "identification_rules": [
    "在月线等大级别上识别一段呈圆弧状缓慢见底的走势，构成《碗底》。",
    "碗底之后价格回到与初始高点相近的水平，形成《碗口》。",
    "价格有效突破碗口对应的历史前高，视为突破确认。",
    "整个形态构建周期极长（白银案例中碗口建立耗时约30年）。",
    "突破后可观察价格回踩碗口位置，再考虑盘整后向上延续。"
  ],
  "common_mistakes": [
    "在碗口顶部高位区域买入，因形态周期太长而长期被套甚至等死。",
    "忽视形态需要数十年构建，低估其调整与持有时间成本。",
    "不分辨《从哪来从哪去》，错判当前位置处于碗底还是碗口高位。"
  ],
  "trading_implication": "碗底形态用于判断超长周期资产的底部反转与买入价值。讲师强调此类形态周期极长，唯有在底部弧形区域买入才有价值，套在高位会因周期太长而长期被套。突破碗口后价格大概率延续上行，回踩碗口位置可作为再入场或盘整后做多的参考。形态主要服务于长线布局而非日内交易。",
  "merge_notes": null,

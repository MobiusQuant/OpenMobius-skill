{
  "global_card_id": "shrinking_candles",
  "global_canonical": "Shrinking Candles",
  "type": "merged_concept",
  "school": "Price Action",
  "aliases": [
    "Shrinking Candle"
  ],
  "definition": "A pattern where consecutive candle bodies progressively decrease in size as price approaches a supply or demand zone, indicating momentum loss from the driving side (buyers or sellers). Each candle pushes price a smaller distance, serving as an early signal of potential reversal from that area. The absence of shrinking candles as price nears a key level suggests the level is more likely to break rather than hold.",
  "definition_per_source": {
    "SMC-Supplement-PLb0LJvd-CX1wZ": "A pattern where consecutive candle bodies progressively decrease in size as price approaches a supply or demand zone, indicating momentum loss from the driving side (buyers or sellers). Each candle pushes price a smaller distance, serving as an early signal of potential reversal from that area. The absence of shrinking candles as price nears a key level suggests the level is more likely to break rather than hold."
  },
  "identification_rules": [
    "Identify a sequence of consecutive candles whose bodies get progressively smaller as price moves toward a key supply or demand zone.",
    "The shrinking must occur in the direction of the move approaching the level — e.g., bullish candles shrinking as price nears resistance, bearish candles shrinking as price nears support.",
    "The pattern must occur as price approaches a previously established key level (support, resistance, supply zone, or demand zone); shrinking candles away from any defined level are not meaningful.",
    "Look for a confirming reversal pattern at the end of the shrinking sequence, such as a doji candle or long wick rejection.",
    "If there is no apparent loss of momentum (no shrinking) as price approaches a key level, the pattern is absent and a breakout is more likely."
  ],
  "common_mistakes": [
    "Using shrinking candles alone as a trade entry signal without combining with other reversal patterns or confluence factors.",
    "Ignoring the absence of shrinking candles when price approaches a key level — if momentum shows no loss, the level is more likely to break rather than hold.",
    "Treating shrinking candles as meaningful when they occur away from any defined supply or demand zone."
  ],
  "trading_implication": "Shrinking candles signal that the side driving price toward a key level is losing control, providing an early warning of reversal — not a standalone trade signal. Works best combined with other reversal patterns (doji, long wick rejection, double top/bottom) at a key level with multiple confluence factors such as trendlines, market structure, and higher time frame levels. In source material, shrinking candles were one of seven confluence factors supporting a high-quality short trade.",
  "merge_notes": null,

{
  "global_card_id": "risk_tolerance",
  "global_canonical": "Risk Tolerance",
  "type": "merged_concept",
  "school": "Risk Management",
  "aliases": [],
  "definition": "The amount of money a trader is comfortable losing per trade and during a losing streak. It determines position sizing and the money management plan, balancing capital preservation against maintaining motivation from gains.",
  "definition_per_source": {
    "SMC-Supplement-PLb0LJvd-CX1wZ": "The amount of money a trader is comfortable losing per trade and during a losing streak. It determines position sizing and the money management plan, balancing capital preservation against maintaining motivation from gains."
  },
  "identification_rules": [
    "Ask what percentage of capital you are willing to risk per trade and still be comfortable losing if the trade goes against you.",
    "Determine how much total account drawdown from consecutive losses (e.g., five in a row) will not cause emotions to affect future trading decisions.",
    "If risking more than you are willing to lose on a specific trade, emotions will control the outcome of that trade — this signals risk tolerance has been exceeded.",
    "If the gain per trade from a very small risk percentage does not satisfy you after the work invested, the risk percentage is too low for your tolerance — you will get discouraged."
  ],
  "common_mistakes": [
    "Risking more than you are comfortable losing on a single trade, causing emotions to control the trade outcome.",
    "Risking too high a percentage (e.g., 5%) so that a normal losing streak of five trades destroys 25% of capital and mentally breaks the trader.",
    "Risking too small a percentage so that gains do not satisfy the trader after the effort invested, leading to discouragement and abandonment of the plan.",
    "Equating blowing an account with losing all money — in reality, losing half your capital is enough to be mentally done."
  ],
  "trading_implication": "Risk tolerance directly shapes the money management plan. A beginner with a small account is recommended to risk 2–3% of capital per trade. At 3% risk, five consecutive losses reduce capital by 15%, which is recoverable. Risking too much (e.g., 5%) leads to 25% drawdowns that are mentally destructive, while risking too little (e.g., 1%) produces gains too small to sustain motivation. The plan must ensure wins encourage continuation and losses do not cause emotional decision-making. Position size is then calculated from the chosen risk percentage, account size, and stop-loss distance in pips.",
  "merge_notes": null,

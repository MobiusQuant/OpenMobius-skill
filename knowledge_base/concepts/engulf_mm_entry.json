{
  "global_card_id": "engulf_mm_entry",
  "global_canonical": "吞没逻辑与做市商进场",
  "type": "merged_concept",
  "school": "SMC",
  "aliases": [
    "吞没结构",
    "吞货逻辑"
  ],
  "definition": "做市商进场吃货的价格行为信号：当一根实体K线把之前留下的影线（针点）完全吞没收回，表示做市商在该位置吸货，是聪明钱进场的基本逻辑，常出现在超卖底部反转处。",
  "definition_per_source": {
    "Teach-Wuyuan": "做市商进场吃货的价格行为信号：当一根实体K线把之前留下的影线（针点）完全吞没收回，表示做市商在该位置吸货，是聪明钱进场的基本逻辑，常出现在超卖底部反转处。"
  },
  "identification_rules": [
    "先找到此前K线留下的影线（针点），影线本质是交易真空。",
    "随后出现一根实体K线，其实体完全把之前的影线/针点吞没收回。",
    "该吞没结构多伴随处于超卖区或位于看涨订单块（欧币加）回踩位置出现。",
    "确认后可结合回踩看涨订单块（欧币加）做多。"
  ],
  "common_mistakes": [
    "在底部超卖区盲目追空，被做市商实体吞没影线后套牢。",
    "只看到下跌一段就认定继续延续下跌，忽视反弹可被拉回吞没空单。",
    "用极端行情（如10月390美金、圣诞节220多美金的连续下跌）当常态去博弈反弹后继续下跌，但这种机会几年才一次。",
    "不识别针点与吞没结构，看到底背离就追空，忽视实体已把影线吞没的反转信号。"
  ],
  "trading_implication": "吞没结构标志做市商在此位置吸货进场，意味着前期下跌可能终结、反转概率上升。讲师强调在底部超卖区不应追空，因为做市商可能用实体吞没影线杀死高位空单。可将吞没位与看涨订单块、FVG回踩结合，在回踩订单块时做多，即便不看其他均线和指标也能据此识别进场逻辑。",
  "merge_notes": null,

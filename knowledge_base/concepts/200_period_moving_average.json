{
  "global_card_id": "200_period_moving_average",
  "global_canonical": "200-Period Moving Average",
  "type": "merged_concept",
  "school": "Indicator Based",
  "aliases": [
    "200 MA",
    "200 moving average"
  ],
  "definition": "A long-term smoothed moving average calculated over 200 periods that defines the macro trend direction. Price trading above it indicates a bullish bias; price trading below it indicates a bearish bias. Serves as a major dynamic support/resistance level and a key take-profit target for reversal trades.",
  "definition_per_source": {
    "SMC-Supplement-PLv-X125": "A long-term smoothed moving average calculated over 200 periods that defines the macro trend direction. Price trading above it indicates a bullish bias; price trading below it indicates a bearish bias. Serves as a major dynamic support/resistance level and a key take-profit target for reversal trades."
  },
  "identification_rules": [
    "Plot a 200-period smoothed moving average on the chart; it appears as the outermost curved line relative to the 21 and 50 moving averages.",
    "Identify the macro trend by observing whether price is trading above the 200 MA (bullish) or below it (bearish).",
    "When price is moving toward the 200 MA from above after a confirmed reversal setup, mark it as a potential take-profit target.",
    "At the 200 MA level, watch for price to either bounce (rejecting and continuing the prior uptrend) or break through (confirming a deeper reversal to the downside)."
  ],
  "common_mistakes": [
    "Assuming that price breaking through a moving average guarantees continuation in that direction—price can break below a moving average and then reverse sharply upward, stopping out early entries.",
    "Entering reversal trades too early without waiting for price to approach or interact with the 200 MA as a target, missing the full measured move."
  ],
  "trading_implication": "The 200 MA is used as a primary take-profit target on reversal trades that have multiple confluences (RSI divergence, break of market structure, moving average retest, three line strike). After entering a short trade confirmed by these confluences, traders target the 200 MA knowing price will reach this level and either reject upward—continuing the original uptrend—or break through and continue the reversal downward. In the example shown, targeting the 200 MA on a six-confluence short trade on EURUSD 15-minute yielded 45 pips.",
  "merge_notes": null,

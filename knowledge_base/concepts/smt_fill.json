{
  "global_card_id": "smt_fill",
  "global_canonical": "SMT Fill",
  "type": "merged_concept",
  "school": "ICT",
  "aliases": [
    "Breakaway Gap SMT",
    "Fair Value Gap SMT"
  ],
  "definition": "An SMT divergence where one asset trades into a fair value gap (internal range liquidity) while its correlated asset leaves the equivalent gap unfilled, creating a breakaway gap. This divergence at the gap level signals a potential reversal away from the internal range liquidity.",
  "definition_per_source": {
    "Education - ICT (Updated)": "An SMT divergence where one asset trades into a fair value gap (internal range liquidity) while its correlated asset leaves the equivalent gap unfilled, creating a breakaway gap. This divergence at the gap level signals a potential reversal away from the internal range liquidity."
  },
  "identification_rules": [
    "Identify a fair value gap on the primary asset that serves as the key level (internal range liquidity).",
    "Confirm the primary asset trades into and reacts at this fair value gap.",
    "Check the correlated asset (from the same triad, e.g., ES/NQ/YM, DXY/EURUSD/GBPUSD, CL/RB/HO) to verify it did not trade into its equivalent gap — the gap remains open as a breakaway gap.",
    "Confirm the divergence at the gap level signals a potential reversal back toward the opposing side of the range."
  ],
  "common_mistakes": [
    "Using SMT Fill without a correlated asset from a proper triad to confirm the divergence.",
    "Acting on the SMT Fill alone without a swing-point confirmation (e.g., candle 2 closure) before anticipating the reversal."
  ],
  "trading_implication": "SMT Fill acts as a first-stage reversal signal at internal range liquidity, used to anticipate price moving from the fair value gap back toward external range liquidity (opposing range high/low). It is most powerful when combined with a candle 2 closure or paired with a second-stage confirmation (swing-point SMT, PSP, or cracking correlation) to form a two-stage SMT sequence. Entries target continuation away from the gap toward the opposing range extreme.",
  "merge_notes": null,

{
  "global_card_id": "regular_bearish_divergence",
  "global_canonical": "Regular Bearish Divergence",
  "type": "merged_concept",
  "school": "Indicator Based",
  "aliases": [
    "Bearish MACD Divergence"
  ],
  "definition": "A bearish reversal signal where price prints a higher high while the MACD (or oscillator) prints a lower high, indicating weakening upward momentum and a potential downside reversal.",
  "definition_per_source": {
    "SMC-Strong-Weak-Supplement": "A bearish reversal signal where price prints a higher high while the MACD (or oscillator) prints a lower high, indicating weakening upward momentum and a potential downside reversal."
  },
  "identification_rules": [
    "Identify two consecutive swing highs on the price chart, with the second high higher than the first.",
    "On the MACD histogram or line, observe the peaks corresponding to those price highs; the second peak must be lower than the first.",
    "Focus exclusively on the highs (not lows) when looking for regular bearish divergence.",
    "Ensure the swing highs are clearly separated by a distinct trough for more reliable signals."
  ],
  "common_mistakes": [
    "Confusing highs with lows; regular bearish divergence focuses on highs, not lows.",
    "Misinterpreting convergence (price and MACD moving in the same direction) as divergence.",
    "Treating overlapping or indistinct peaks as valid divergence, leading to false signals."
  ],
  "trading_implication": "Suggests waning bullish momentum and a likely trend reversal to the downside. Traders may use it to enter short positions or exit longs, often in conjunction with other confirmation tools.",

{
  "global_card_id": "projection_target_levels",
  "global_canonical": "Projection Target Levels",
  "type": "merged_concept",
  "school": "ICT",
  "aliases": [
    "Fibonacci Projection Targets"
  ],
  "definition": "基于操纵腿（Manipulation Leg）大小，使用斐波那契投影工具计算的价格目标位。正常腿瞄准-2至-2.5标准差，大腿瞄准-1标准差，极端情况可扩展至-4至-4.5。",
  "definition_per_source": {
    "Education - ICT": "基于操纵腿（Manipulation Leg）大小，使用斐波那契投影工具计算的价格目标位。正常腿瞄准-2至-2.5标准差，大腿瞄准-1标准差，极端情况可扩展至-4至-4.5。"
  },
  "identification_rules": [
    "在Candle 2反转点处识别Change in State of Delivery（CSD）",
    "找到操纵腿的低点，再找到形成该低点的摆动高点（或反向）",
    "用斐波那契回撤工具锚定在低点，延伸至摆动高点，生成投影水平线",
    "根据操纵腿大小判断目标等级：正常腿（相对较小）→ -2至-2.5；大腿（接近目标范围的一半）→ -1标准差；极端腿 → -4至-4.5"
  ],
  "common_mistakes": [
    "对所有操纵腿大小使用相同的投影目标（-2至-2.5），忽视大腿应瞄准-1标准差的调整",
    "在缺乏CSD确认前过早标记投影",
    "贪心持仓至最终目标（-4至-4.5）而不在-2至-2.5的流动性点获利，导致价格反转时失去整个收益"
  ],
  "trading_implication": "投影目标提供价格可能停止或反转的预期区域。在缺乏流动性的区域（如历史新高）或作为与其他汇聚因素（如前期高点、左侧流动性）结合的确认工具使用。根据操纵腿大小调整预期：大腿应降低目标预期至-1而非-2，避免不合理的价格移动预测。",
  "merge_notes": null,

{
  "global_card_id": "partial_profit_taking",
  "global_canonical": "Partial Profit Taking",
  "type": "merged_concept",
  "school": "ICT",
  "aliases": [
    "分批平仓",
    "分次获利"
  ],
  "definition": "在单笔交易中分多次平仓获利的策略。通常在等低点、订单块或公允价值缺口处设置第一、二、三部分平仓位，逐步锁定利润。",
  "definition_per_source": {
    "Education - ICT": "在单笔交易中分多次平仓获利的策略。通常在等低点、订单块或公允价值缺口处设置第一、二、三部分平仓位，逐步锁定利润。"
  },
  "identification_rules": [
    "在进场后识别价格路径上的关键支撑/阻力位（如摆动低点、订单块、FVG）",
    "将这些关键位标记为第一、二、三平仓目标",
    "第一平仓通常设在最近的摆动低点或小型订单块处",
    "第二平仓设在更远的订单块或FVG处",
    "第三平仓或最终头寸持有至更高的目标位或摆动高点"
  ],
  "common_mistakes": [
    "材料未明确提及常见误区"
  ],
  "trading_implication": "分批平仓允许交易者在价格向目标方向运行时逐步锁定利润，同时保留部分头寸以捕捉更大的移动。这种方法降低了单次平仓的时机风险，并在达到第一目标后即可收回初始风险。材料中示例显示第一平仓在等低点处、第二平仓在更高的订单块或FVG处、第三平仓在摆动高点附近。",
  "merge_notes": null,

{
  "global_card_id": "ruler_flagpole_measure",
  "global_canonical": "刻度尺/旗杆跌幅测算",
  "type": "merged_concept",
  "school": "Elliott Wave",
  "aliases": [
    "刻度尺测算",
    "旗杆测算",
    "杖子/斜边W划分",
    "波浪理论跌幅测算"
  ],
  "definition": "结合波浪理论将下跌结构划分为杖子/斜边W、三段式或五段式（12345），并用刻度尺（旗杆）以前期涨幅百分比测算目标跌幅，推算行情可能下探的关键支撑位。",
  "definition_per_source": {
    "Teach-Wuyuan": "结合波浪理论将下跌结构划分为杖子/斜边W、三段式或五段式（12345），并用刻度尺（旗杆）以前期涨幅百分比测算目标跌幅，推算行情可能下探的关键支撑位。"
  },
  "identification_rules": [
    "先用波浪理论判断当前下跌属杖子（一段）、斜边W、三段式（abc）还是五段式（12345）结构。",
    "若三段式跌幅不够，可能会反弹一节后延伸为五段式，使整体下跌更完整。",
    "用刻度尺（旗杆）量出前期涨幅作为标尺，按固定百分比测算跌幅，如白银47%跌幅对应周线级支撑47-49附近。",
    "测算时对比当前已跌幅度与目标百分比的差距，例如白银当前仅跌31%，距47%尚有空间，目标价更低。",
    "测算出的目标位需与其他级别关键支撑（如周线支撑、EMA100）相互印证才视为有效。"
  ],
  "common_mistakes": [
    "在波浪结构未完整、跌幅未到测算目标时过早判定行情走完。",
    "误把三段式当作终点，忽视其可能延伸为五段式导致进一步下跌。",
    "讲师认为波浪理论过于主观、职业交易者不用，单靠波浪划分容易因主观划法误判。",
    "测算目标位未与其他级别支撑或均线交叉验证就贸然进场。"
  ],
  "trading_implication": "用于在下跌行情中推算目标位与潜在支撑区，提示何时不应继续追空、何时应在关键支撑准备做多。讲师以白银47%跌幅推算到周线支撑47-49附近（亦对应EMA100约49），原油走出4小时完整五段后认为大幅下杀接近释放完毕。当价格接近测算支撑时不再压住空单，转而寻找做多机会。",
  "merge_notes": null,

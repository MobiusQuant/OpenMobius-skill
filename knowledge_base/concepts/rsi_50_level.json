{
  "global_card_id": "rsi_50_level",
  "global_canonical": "RSI 50 Level",
  "type": "merged_concept",
  "school": "Indicator Based",
  "aliases": [
    "50 Level",
    "50 line",
    "RSI 50",
    "RSI 50 line",
    "RSI Midline",
    "RSI Midpoint"
  ],
  "definition": "The midpoint line of the Relative Strength Index scale, replacing the default 70/30 overbought/oversold boundaries with a single horizontal line at 50. RSI above 50 indicates bullish momentum; below 50 indicates bearish momentum. A crossover through 50 confirms a shift in trend direction. Used as a simplified binary momentum divider for directional bias and as a confirmation trigger that validates divergence setups before entry.",
  "definition_per_source": {
    "SMC-Supplement-PLv-X125": "The midpoint line of the Relative Strength Index scale, replacing the default 70/30 overbought/oversold boundaries with a single horizontal line at 50. RSI above 50 indicates bullish momentum; below 50 indicates bearish momentum. A crossover through 50 confirms a shift in trend direction. Used as a simplified binary momentum divider for directional bias and as a confirmation trigger that validates divergence setups before entry."
  },
  "identification_rules": [
    "Replace the default RSI upper band (70) and lower band (30) with a single horizontal line at the 50 level in the RSI indicator settings; remove the RSI background fill as it provides no useful information with this configuration.",
    "When the RSI line is trading above 50, classify current momentum as bullish and consider only long positions.",
    "When the RSI line is trading below 50, classify current momentum as bearish and consider only short positions.",
    "Monitor crossovers of the RSI through the 50 level as potential shifts in momentum direction.",
    "After identifying a regular divergence (e.g., higher highs on price with lower highs on RSI, or higher lows on RSI with lower lows on price), wait for the RSI to cross the 50 level in the direction of the expected reversal before confirming the setup as actionable.",
    "Use the 50 level reading in conjunction with other confluences — moving average alignment (21, 50, 200), Fibonacci retracement levels, market structure breaks, and price action signals — before entering a trade."
  ],
  "common_mistakes": [
    "Using the default 70/30 RSI bands instead of reconfiguring to a single 50 level, which misses the momentum-shift confirmation signal.",
    "Trading a divergence as soon as it appears without waiting for RSI to cross the 50 level, leading to premature entries while the trend continues against you.",
    "Treating the 50 level as a standalone entry signal rather than using it as a directional filter alongside other confluences such as divergences, moving averages, support/resistance, and Fibonacci levels.",
    "Treating a single lower high or higher low on RSI as sufficient to enter without waiting for the RSI to confirm through 50 and other confluences to align.",
    "Assuming that because price broke through a moving average the reversal is confirmed, without checking whether the RSI has also crossed the 50 level."
  ],
  "trading_implication": "The RSI 50 level acts as a directional filter and divergence confirmation tool. Rather than entering on the first divergence signal, traders wait for RSI to cross 50 to confirm genuine momentum shift, reducing premature entries where divergence forms but price continues trending. When combined with moving average alignment, Fibonacci retracement zones, and market structure breaks, it builds high-probability setups. It simplifies intraday momentum reading into a clean bullish/bearish binary without traditional overbought/oversold noise.",
  "merge_notes": null,

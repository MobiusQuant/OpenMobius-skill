{
  "global_card_id": "high_volume_node",
  "global_canonical": "High Volume Node",
  "type": "merged_concept",
  "school": "Order Flow",
  "aliases": [
    "HVN",
    "高成交量节点",
    "高成交量节点(HVN)",
    "密集成交区",
    "成交量高峰区",
    "资产平衡价值区"
  ],
  "definition": "成交量分布图中成交量最高的价位区域，代表多空相对平衡的密集成交价值区，散户在此密集挂单与博弈。价格接近时倾向横向震荡，难以立即突破，常构成支撑或阻力。",
  "definition_per_source": {
    "Teach-Wuyuan": "成交量分布图中成交量最高的价位区域，代表多空相对平衡的密集成交价值区，散户在此密集挂单与博弈。价格接近时倾向横向震荡，难以立即突破，常构成支撑或阻力。"
  },
  "identification_rules": [
    "在VRVP、SVP或固定范围成交量分布图中，找出成交量柱体最长（峰值）的价位区间即为高成交量节点。",
    "该区域内多单与空单成交量基本平衡，是价格反复停留、横向震荡的密集成交带。",
    "在固定范围成交量分布中拉取一段行情的高低点，系统自动生成的成交量最集中价位即为散户下单区。",
    "图表越大级别建议改用VRVP观察；固定范围成交量分布需调整宽度（如150）以使大级别节点显示清晰。"
  ],
  "common_mistakes": [
    "误以为下跌后套牢盘已全部爆仓出局，实则仍有大量人扛单挂在高成交区等待解套。",
    "期待价格能轻易冲破上方密集成交区解套，而做市商往往故意打到差一点的位置不让解套。",
    "在大级别误用固定范围成交量分布工具，宽度设置不当导致节点显示难以辨认；大级别应改用VRVP。",
    "拖动图表时VRVP的可见K线变化会使POC与节点位置改变，存在延迟。"
  ],
  "trading_implication": "高成交量节点是散户密集成交的价值平衡区，价格接近时市场不太可能立即突破，倾向横向震荡盘整。价格上方的密集成交区会成为套牢盘的解套压力位，构成第一道阻力；下方的密集区则可提供支撑。讲师指出散户多在此区博弈，机构（做市商）则在节点两侧的低成交量节点（LVN）动手，借此阻止散户解套。识别HVN可在不切级别情况下预判支撑阻力与盘整区间。",
  "merge_notes": null,

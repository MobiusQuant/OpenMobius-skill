{
  "global_card_id": "break_even",
  "global_canonical": "Break Even",
  "type": "merged_concept",
  "school": "Risk Management",
  "aliases": [
    "BE",
    "Break Even Point",
    "Break-Even",
    "Moving Stop to Break Even",
    "break-even technique",
    "risk-free trade"
  ],
  "definition": "A risk management technique where half the position is closed when price reaches a predetermined profit target (typically 1:1 or 2:1 risk-to-reward), and the stop-loss on the remaining position is moved to the entry price. The realized profit from the closed half offsets the maximum possible loss on the remaining half, making the trade risk-free. Alternatively, two half-sized trades are opened at entry with separate targets. The remaining position runs toward a higher time frame target with zero net risk exposure.",
  "definition_per_source": {
    "SMC-Supplement-PLb0LJvd-CX1wZ": "A risk management technique where half the position is closed when price reaches a predetermined profit target (typically 1:1 or 2:1 risk-to-reward), and the stop-loss on the remaining position is moved to the entry price. The realized profit from the closed half offsets the maximum possible loss on the remaining half, making the trade risk-free. Alternatively, two half-sized trades are opened at entry with separate targets. The remaining position runs toward a higher time frame target with zero net risk exposure."
  },
  "identification_rules": [
    "Measure the distance from entry to stop-loss to define one unit of risk (1R). The trade must be active with a defined stop-loss before break-even management can be applied.",
    "When price moves in the trade's favor by the predetermined trigger distance (1R or 2R depending on the strategy), close exactly half of the open position to lock in partial profit.",
    "Alternatively, open two separate trades at entry, each sized at half the normal risk, with one trade's take-profit set at the break-even trigger level and the other targeting the higher time frame level.",
    "After the partial close, reposition the stop-loss on the remaining position to the entry price, ensuring the locked-in profit covers any potential loss on the remaining half for a net-zero worst-case outcome.",
    "Hold the remaining half position open until price reaches the higher time frame target (e.g., supply/demand zone, major structure level, or turning point)."
  ],
  "common_mistakes": [
    "Not checking higher time frames for nearby structure levels that could prevent price from reaching the partial-profit target, such as a monthly zone causing reversal.",
    "Applying break even in choppy or non-trending markets where the setup lacks a clear directional bias, reducing the probability of reaching the target.",
    "Letting a winning trade come all the way back to hit the stop-loss without applying any break-even technique, turning a winner into a loser.",
    "Closing the entire position in partial profits too early out of fear, missing the long-term target the market would have reached.",
    "Not accounting for situations requiring early closure of the remaining position, such as high-impact news releases or end-of-trading-week slippage risk.",
    "Moving the stop-loss to break even too early when the market still has fluctuations before reaching higher time frame key levels, causing premature stop-outs.",
    "Not giving the remaining position enough room to breathe during deep retracements by attaching the stop too tightly to candle bottoms.",
    "Focusing only on win rate while ignoring how break-even techniques interact with risk-to-reward ratio to determine overall profitability."
  ],
  "trading_implication": "Break even eliminates downside risk after securing partial profit, freeing the remaining position to pursue higher time frame targets without psychological pressure. By closing half at the trigger level, the trader guarantees no net loss even if the market reverses. The remaining position can then capture significantly larger moves (e.g., 1:5 R:R) toward key structure levels. This balances capital protection with upside potential and removes the regret of closing too early or holding too long. The remaining position can also be managed around high-impact news or end-of-week slippage risk.",
  "merge_notes": null,

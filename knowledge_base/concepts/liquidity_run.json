{
  "global_card_id": "liquidity_run",
  "global_canonical": "Liquidity Run",
  "type": "merged_concept",
  "school": "ICT",
  "aliases": [],
  "definition": "A price movement where price aggressively breaks a high or low and continues in the same direction, using the liquidity at that level (stop losses, breakout orders) to fuel momentum, rather than reversing back inside the range.",
  "definition_per_source": {
    "SMC-Extra-Supplement": "A price movement where price aggressively breaks a high or low and continues in the same direction, using the liquidity at that level (stop losses, breakout orders) to fuel momentum, rather than reversing back inside the range."
  },
  "identification_rules": [
    "Identify a clearly defined high or low that contains accumulated liquidity (e.g., equal highs/lows, session highs/lows, or structural levels).",
    "Price must break that level with strong momentum, closing beyond it on the current timeframe.",
    "After the break, price does not immediately wick back into the prior range; instead, it continues moving in the breakout direction, often accelerating as additional liquidity is triggered.",
    "The run is typically aligned with existing bullish or bearish market structure (higher highs/higher lows or lower lows/lower highs)."
  ],
  "common_mistakes": [
    "Confusing a liquidity run with a liquidity sweep, expecting price to reverse after the break instead of continuing.",
    "Entering a trade before confirmation of the run, leading to premature entries against the actual momentum.",
    "Ignoring the broader market structure and bias, such as shorting a bearish run without confirming bearish structure and liquidity accumulation."
  ],
  "trading_implication": "A liquidity run signals a continuation move, indicating that institutional order flow is propelling price through a key level. Traders can enter in the direction of the run upon a confirmed break and retest, or hold existing positions with targets at the next liquidity pool. It validates the directional bias and provides a high-probability entry opportunity.",
  "merge_notes": null,

{
  "global_card_id": "long_wick_rejection",
  "global_canonical": "Long Wick Rejection",
  "type": "merged_concept",
  "school": "Price Action",
  "aliases": [
    "Long Wick Candlestick",
    "Long Wick Candlestick Pattern",
    "Wick Rejection",
    "candlestick rejection",
    "long wick candlestick rejection"
  ],
  "definition": "A candlestick with a long wick at a key supply, demand, support, or resistance level indicating that price moved sharply into that zone but was forcefully pushed back by opposing pressure, with the body closing away from the level. The extended wick reveals that one side attempted to move price but was overwhelmed, signaling a potential reversal. Used as an entry confirmation signal, typically after a pullback to a structural level.",
  "definition_per_source": {
    "SMC-Supplement-PLb0LJvd-CX1wZ": "A candlestick with a long wick at a key supply, demand, support, or resistance level indicating that price moved sharply into that zone but was forcefully pushed back by opposing pressure, with the body closing away from the level. The extended wick reveals that one side attempted to move price but was overwhelmed, signaling a potential reversal. Used as an entry confirmation signal, typically after a pullback to a structural level."
  },
  "identification_rules": [
    "The candlestick must form at a previously identified key level such as a support, resistance, supply zone, demand zone, or neckline.",
    "The wick extending into the key level must be significantly longer than the candle body, showing price was pushed sharply into the level before being rejected.",
    "The candle body should close away from the key level on the opposite side of the wick, confirming that opposing pressure (buyers or sellers) regained control by the close of the candlestick period.",
    "The rejection should occur after a pullback or retest of the level, not during the initial move toward it."
  ],
  "common_mistakes": [
    "Entering the market immediately after a pattern completes without waiting for a candlestick rejection at the key level, resulting in a large stop-loss.",
    "Trading a long wick rejection in isolation without combining it with other confirming signals such as shrinking candles, double top/bottom patterns, trendlines, or engulfing candles.",
    "Failing to ensure the long wick rejection occurs at a meaningful key level — trading it in the middle of nowhere reduces its effectiveness.",
    "Missing the trade entirely by waiting for a perfect candlestick formation that never appears, rather than considering alternative entry methods like Fibonacci retracement.",
    "Failing to combine the pattern with higher time frame directional bias and lower time frame entry confirmation.",
    "Not backtesting the pattern on multiple pairs to build confidence and calculate reliable results before trading it live."
  ],
  "trading_implication": "A long wick rejection serves as a reversal confirmation signal at areas of multiple confluence, confirming that a key level is actively defended. It is most effective when combined with other price action signals such as shrinking candles, double top/bottom patterns, trendline reactions, or engulfing candles, rather than traded in isolation. The stop-loss is placed beyond the swing high/low, targeting at least a 1:2 risk-to-reward ratio. Higher time frame directional bias and lower time frame entry confirmation further strengthen the setup.",
  "merge_notes": null,

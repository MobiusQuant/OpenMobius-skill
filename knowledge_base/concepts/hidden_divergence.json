{
  "global_card_id": "hidden_divergence",
  "global_canonical": "Hidden Divergence",
  "type": "merged_concept",
  "school": "Indicator Based",
  "aliases": [
    "Continuation Divergence",
    "Trend Continuation Divergence",
    "hidden div"
  ],
  "definition": "A trend continuation divergence between price and RSI. In an uptrend, price makes a higher low while RSI makes a lower low (hidden bullish), indicating the market was more oversold yet still pushed higher. In a downtrend, price makes a lower high while RSI makes a higher high (hidden bearish), indicating the market was more overbought yet still pushed lower. Hidden divergences confirm the existing trend rather than signaling reversal, and always outweigh regular divergences.",
  "definition_per_source": {
    "SMC-Supplement-PLv-X125": "A trend continuation divergence between price and RSI. In an uptrend, price makes a higher low while RSI makes a lower low (hidden bullish), indicating the market was more oversold yet still pushed higher. In a downtrend, price makes a lower high while RSI makes a higher high (hidden bearish), indicating the market was more overbought yet still pushed lower. Hidden divergences confirm the existing trend rather than signaling reversal, and always outweigh regular divergences."
  },
  "identification_rules": [
    "Confirm the prevailing trend using market structure: higher highs and higher lows for an uptrend, lower highs and lower lows for a downtrend.",
    "For hidden bullish divergence, compare two consecutive swing lows in an uptrend: price must form a higher low while the corresponding RSI reading forms a lower low.",
    "For hidden bearish divergence, compare two consecutive swing highs in a downtrend: price must form a lower high while the corresponding RSI reading forms a higher high.",
    "Draw trend lines connecting the two compared price points and corresponding lines on the RSI to visually confirm the divergence; use vertical lines to precisely align swing points with RSI readings.",
    "Only look for hidden bullish divergences during confirmed uptrends and hidden bearish divergences during confirmed downtrends.",
    "Verify the RSI remains within the momentum range (inside the 70/30 band) to confirm the trend still has momentum supporting continuation.",
    "For highest conviction, verify that the pullback lands within the Fibonacci 0.618 retracement zone of the preceding impulse move or at a key level (support/resistance, round number, moving average, or trend line).",
    "Wait for a strong rejection candle at the divergence point before entering; a single big rejection candle is sufficient for hidden divergences.",
    "Use RSI with period 14; optionally set the midline to 50 rather than the default 70/30 overbought/oversold framework."
  ],
  "common_mistakes": [
    "Focusing only on regular (reversal) divergences while ignoring hidden divergences, which are more important for trend continuation and outweigh concurrent regular divergences.",
    "Trading against the trend by entering counter-trend on a regular divergence when a hidden divergence simultaneously confirms trend continuation.",
    "Confusing hidden divergences with regular divergences — regular divergences signal reversals (drawn on trend extremes) while hidden divergences signal continuation (drawn on swing lows in uptrends, swing highs in downtrends).",
    "Looking for hidden bullish divergences in a downtrend or hidden bearish divergences in an uptrend instead of matching the divergence type to the prevailing trend direction.",
    "Failing to first confirm the prevailing market structure before identifying the divergence, leading to misclassified signals.",
    "Failing to check whether RSI remains in the momentum range (inside the 70/30 band), which confirms the hidden divergence has strength behind it.",
    "Using hidden divergences in isolation without combining them with other confluences such as trend lines, support/resistance, Fibonacci levels, and market structure.",
    "Using the RSI solely as an overbought/oversold indicator rather than as a momentum and divergence tool.",
    "Trading divergences on lower time frames without accounting for increased false signals compared to higher time frames.",
    "Taking too many low-quality setups instead of waiting for multiple confluences to align simultaneously.",
    "Getting faked out by a price wick beyond a zone and entering a counter-trend trade instead of recognizing the hidden divergence as a continuation signal.",
    "Using idealized textbook illustrations as reference instead of studying real market examples where divergences appear less clean."
  ],
  "trading_implication": "Hidden divergences signal the prevailing trend is likely to continue despite a temporary pullback, making them higher-priority signals than regular divergences. Enter in the trend direction at the divergence point, ideally when stacked with confluences such as Fibonacci retracement, support/resistance, or trend lines. Place stop loss beyond the rejection candle. Target the previous swing high (longs) or swing low (shorts), aiming for at least 1:2 risk-to-reward. Higher time frames produce more reliable signals. Experienced traders may close 90% at target and trail the remainder.",
  "merge_notes": null,

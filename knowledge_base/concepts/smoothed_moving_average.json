{
  "global_card_id": "smoothed_moving_average",
  "global_canonical": "Smoothed Moving Average",
  "type": "merged_concept",
  "school": "Indicator Based",
  "aliases": [
    "SMMA",
    "Smoothed MA"
  ],
  "definition": "A moving average that applies additional smoothing to reduce price noise, distinct from simple or exponential moving averages. Applied at periods 21, 50, and 200, these three lines overlay the chart as dynamic support and resistance levels. Their slope alignment confirms trend bias, the 200-period defines macro trend direction, the 21-period tracks short-term momentum for entry rejections, and price distance from the lines signals mean-reversion opportunities.",
  "definition_per_source": {
    "SMC-Supplement-PLv-X125": "A moving average that applies additional smoothing to reduce price noise, distinct from simple or exponential moving averages. Applied at periods 21, 50, and 200, these three lines overlay the chart as dynamic support and resistance levels. Their slope alignment confirms trend bias, the 200-period defines macro trend direction, the 21-period tracks short-term momentum for entry rejections, and price distance from the lines signals mean-reversion opportunities."
  },
  "identification_rules": [
    "Add three separate Smoothed Moving Average indicators to the chart at periods 21, 50, and 200, ensuring the type is 'smoothed' rather than simple (SMA) or exponential (EMA).",
    "Assign distinct colors to each line for visual clarity (e.g., white for 21, green for 50, red for 200).",
    "Price trading above all three SMMAs indicates a bullish macro trend; price below all three indicates a bearish macro trend.",
    "The 200 SMMA defines the macro trend filter: price above it is bullish (look for longs), price below it is bearish (look for shorts).",
    "Confirm all three moving averages are sloping in the same direction — downward for short bias, upward for long bias — before considering trade entries.",
    "Watch for price rejections off the 21 SMMA as the primary dynamic support/resistance for trend continuation entries.",
    "When price is far from the moving averages (overextended), expect a reversion move back toward the nearest MA, starting with the 21.",
    "Observe crossovers of the SMMA lines to gauge shifts in short-, medium-, and long-term momentum."
  ],
  "common_mistakes": [
    "Entering trades when the 21, 50, and 200 moving averages are not all aligned in the same direction, leading to trades against the prevailing trend.",
    "Ignoring the 200 SMMA as the macro trend filter — taking longs while price trades below it or shorts while price trades above it.",
    "Holding a mean-reversion trade beyond the initial MA target instead of taking the planned exit at the 21 MA.",
    "Ignoring how overextended price is from the moving averages and failing to anticipate reversion moves.",
    "Not using multiple time frames — analyzing MA distance on a higher time frame (e.g., 15-minute) then refining entries on a lower time frame.",
    "Using SMMA rejections in isolation without confirming with RSI momentum or price action signals like wicks and retests.",
    "Confusing smoothed moving averages with simple or exponential moving averages, which have different calculations and produce different lines.",
    "Failing to add three separate instances of the indicator and instead trying to plot all three periods on a single indicator instance."
  ],
  "trading_implication": "The three SMMAs (21, 50, 200) form a layered trend-confirmation and dynamic support/resistance framework. When all three align directionally, the trader has a clear bias. The 21 SMMA serves as the primary rejection level for trend continuation entries and the first mean-reversion take-profit target when price is overextended. The 50 and 200 provide secondary support/resistance. Combining SMMA rejections with Fibonacci retracement levels and RSI momentum (e.g., RSI below 50 for shorts) creates high-confluence entries. Higher time frame MA analysis guides lower time frame entries.",
  "merge_notes": null,

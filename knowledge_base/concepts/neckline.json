{
  "global_card_id": "neckline",
  "global_canonical": "Neckline",
  "type": "merged_concept",
  "school": "Price Action",
  "aliases": [],
  "definition": "The horizontal level connecting the lows of a double top (the valley between the two peaks in an M-shape) or the highs of a double bottom (the peak between the two troughs in a W-shape). A decisive price close beyond the neckline confirms pattern completion and signals a potential trend reversal. It subsequently serves as a reference level for pullback entries and Fibonacci retracement-based trade planning.",
  "definition_per_source": {
    "SMC-Supplement-PLb0LJvd-CX1wZ": "The horizontal level connecting the lows of a double top (the valley between the two peaks in an M-shape) or the highs of a double bottom (the peak between the two troughs in a W-shape). A decisive price close beyond the neckline confirms pattern completion and signals a potential trend reversal. It subsequently serves as a reference level for pullback entries and Fibonacci retracement-based trade planning."
  },
  "identification_rules": [
    "In a double top (M-shape), draw a horizontal line at the lowest point between the two peaks — this is the neckline.",
    "In a double bottom (W-shape), draw a horizontal line at the highest point between the two troughs — this is the neckline.",
    "A valid neckline break requires price to close beyond the level (above for double bottom, below for double top), confirming the reversal pattern.",
    "The neckline break must occur after the second touch of the pattern has formed and price has moved away from the key level.",
    "After the neckline break, expect a pullback toward the neckline area before continuation in the breakout direction."
  ],
  "common_mistakes": [
    "Entering immediately after the neckline break, resulting in an excessively large stop-loss and poor risk-to-reward ratio.",
    "Taking an aggressive entry at the second touch without waiting for the neckline break when more conservative confirmation is warranted.",
    "Trading a neckline break in isolation without confirming it occurred at a key area of confluence (e.g., key structure level, trendline, smart money concepts), reducing it to a simple break and retest.",
    "Confusing a reaction to an area with a confirmed reversal — a reaction alone does not mean a reversal; the neckline break provides that confirmation.",
    "Failing to wait for a pullback after the neckline break to get a better entry price using Fibonacci retracement.",
    "Waiting for a pullback to the neckline may cause missed trades if no clear candlestick rejection forms."
  ],
  "trading_implication": "A neckline break confirms the double top or double bottom reversal. An aggressive entry can be taken at the second touch using candlestick confirmation (e.g., engulfing or momentum candle), while the conservative approach waits for the neckline break. Entering immediately at the break often results in an excessively large stop-loss. A refined method waits for a pullback to the neckline, looking for candlestick rejections (e.g., long wick), or combines the break with a 61.8% Fibonacci retracement for a precise limit order with improved risk-to-reward. The signal is strongest at areas of high confluence.",
  "merge_notes": null,

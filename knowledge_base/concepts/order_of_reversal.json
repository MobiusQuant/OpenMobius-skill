{
  "global_card_id": "order_of_reversal",
  "global_canonical": "Order of Reversal",
  "type": "merged_concept",
  "school": "ICT",
  "aliases": [],
  "definition": "A hierarchical sequence of confirmation levels for a reversal, ranging from least to most confirmed: turtle soup (liquidity sweep), inversion (FVG close), change in state of delivery (opposing candle closure), breaker block, and fair value gap. Each stage adds confirmation that a reversal has formed.",
  "definition_per_source": {
    "Education - ICT (Updated)": "A hierarchical sequence of confirmation levels for a reversal, ranging from least to most confirmed: turtle soup (liquidity sweep), inversion (FVG close), change in state of delivery (opposing candle closure), breaker block, and fair value gap. Each stage adds confirmation that a reversal has formed."
  },
  "identification_rules": [
    "Turtle soup: price sweeps a swing high or low and closes back inside the range.",
    "Inversion: price closes through a fair value gap in the opposite direction of the prior trend.",
    "Change in state of delivery: price closes above a series of down-close candles (bullish) or below up-close candles (bearish).",
    "Breaker block: price forms a low-high-lower low-higher high (bullish) or high-low-higher high-lower low (bearish) sequence.",
    "Fair value gap: a three-candlestick imbalance remains unfilled in the reversal direction."
  ],
  "common_mistakes": [
    "Attempting to use all PD arrays simultaneously, causing confusion and lack of a repeatable strategy.",
    "Jumping to new concepts when struggling instead of refining the chosen one.",
    "Not understanding that less confirmation means higher risk of stop-outs."
  ],
  "trading_implication": "Traders should master one PD array from the sequence for consistency rather than using all. Each level offers increasing confirmation: turtle soup has the least, fair value gap the most. Choosing one provides a repeatable entry model with clear stop placement and data collection.",
  "merge_notes": null,

{
  "global_card_id": "major_level_of_structure",
  "global_canonical": "Major Level of Structure",
  "type": "merged_concept",
  "school": "Price Action",
  "aliases": [
    "Key Level",
    "Key Level of Structure",
    "Major level of market structure",
    "Qualified Support and Resistance Level",
    "high probability trading zone",
    "higher time frame key level",
    "key level of market structure",
    "optimal trading zone"
  ],
  "definition": "A horizontal price zone that has been rejected multiple times, has acted as both support and resistance (role flip), and was recently respected by price. Typically identified on a higher time frame at swing highs or swing lows, it should be visually obvious and produce drastic price bounces. The more qualifying criteria met—multiple rejections, dual role, recency, visual obviousness, location at swing extremes, sharp reactions—the higher the zone's quality and reliability for reversal entries on lower time frames.",
  "definition_per_source": {
    "SMC-Supplement-PLb0LJvd-CX1wZ": "A horizontal price zone that has been rejected multiple times, has acted as both support and resistance (role flip), and was recently respected by price. Typically identified on a higher time frame at swing highs or swing lows, it should be visually obvious and produce drastic price bounces. The more qualifying criteria met—multiple rejections, dual role, recency, visual obviousness, location at swing extremes, sharp reactions—the higher the zone's quality and reliability for reversal entries on lower time frames."
  },
  "identification_rules": [
    "The zone must show multiple rejections—price approached and reversed from the same horizontal area on at least two or more separate occasions.",
    "The zone must have acted as both support and resistance at different points in price history, demonstrating a role flip.",
    "The zone must have been recently respected, meaning price reacted to it in the near past rather than only historically; latest levels take priority over older ones.",
    "The zone should be located at a swing high or swing low on the chart.",
    "The zone must be visually obvious, identifiable within seconds of looking at the chart without extensive searching.",
    "Price should have bounced away from the zone drastically, reversing sharply with large candles rather than producing a minor reaction.",
    "Mark the zone as a horizontal rectangle spanning the cluster of rejections rather than a single precise line.",
    "Identify the zone on a higher time frame (e.g., 1-hour, 4-hour, or daily) before zooming into lower time frames for entry signals.",
    "Verify sufficient space exists above or below the zone before the next major opposing supply or demand level, ensuring adequate room for price to move in the intended direction.",
    "Not all criteria are required, but the more criteria the zone satisfies, the higher its quality and reliability."
  ],
  "common_mistakes": [
    "Treating any support or resistance level as a major level without verifying it meets the qualifying criteria (multiple rejections, dual role as support and resistance, recent respect).",
    "Entering trades immediately when price reaches the zone without dropping to a lower time frame for confirmation via a reversal pattern such as a double bottom or neckline break.",
    "Trading at these levels when the market lacks a clear trend direction on the higher time frame.",
    "Using the level in isolation without combining it with other confluences such as trend lines to form an area of high convergence.",
    "Treating a reaction at the level as an automatic reversal signal—a reaction does not guarantee reversal; price action confirmation is required.",
    "Ignoring the recency criterion—old, untested levels carry less significance than recently respected ones.",
    "Failing to check how much room price has before the next opposing supply or demand zone, which can invalidate the setup's risk-to-reward potential.",
    "Confusing minor swing levels with major levels of structure, which require higher-quality qualifying criteria.",
    "Trading double tops or double bottoms in the middle of nowhere without first identifying a major level of structure on the higher time frame.",
    "Requiring all qualifying criteria to be met before marking a level—only one criterion is needed, though more criteria increase quality."
  ],
  "trading_implication": "When price enters a major level of structure, expect a reaction or rejection. Traders identify the zone on the higher time frame, then drop to a lower time frame for reversal confirmation patterns such as double top/bottom, engulfing candles, long wick rejections, or trend line breaks. After confirmation (e.g., neckline break), a Fibonacci retracement (61.8%) can refine entry. Stop-loss is placed beyond the pattern's swing extreme (one ATR below/above). Targets are set at the next higher time frame structure level. Confluence with trend lines or other factors increases probability.",
  "merge_notes": null,

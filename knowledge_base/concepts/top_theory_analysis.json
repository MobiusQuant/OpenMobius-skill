{
  "global_card_id": "top_theory_analysis",
  "global_canonical": "见顶论辨析",
  "type": "merged_concept",
  "school": "Indicator Based",
  "aliases": [
    "见顶论",
    "顶部判定"
  ],
  "definition": "用通用线系统辨析网络流传的趋势见顶言论：只有当本级别EMA60被实体K线有效跌破，趋势才算结束；EMA60未破则趋势未终结，所谓见顶不成立。",
  "definition_per_source": {
    "Teach-Wuyuan": "用通用线系统辨析网络流传的趋势见顶言论：只有当本级别EMA60被实体K线有效跌破，趋势才算结束；EMA60未破则趋势未终结，所谓见顶不成立。"
  },
  "identification_rules": [
    "将通用线系统（EMA20/60/100）引用到目标级别（如日线）图上观察。",
    "检查本级别EMA60是否被一根实体K线有效跌破并收线确认；未跌破即趋势未结束。",
    "观察价格结构是否破坏：日线未跌破前低（如4527）即未进入熊市，见顶论不成立。",
    "结合裸K结构判断，如下跌后形成W底等反转结构，可视为启动而非见顶。",
    "对照历史相似走势段落（如今年10月与当前的下跌-上涨-下跌节奏）进行类比验证。"
  ],
  "common_mistakes": [
    "被网络见顶言论和新闻消息吓到，在下跌中恐慌而不敢在支撑处买入。",
    "在EMA60未被破坏、趋势未结束时就判定见顶并做空。",
    "下跌时不敢买（4500/4600），反在上涨后高位追单，性价比差。",
    "重仓博一单大赚，而非在明确支撑位试仓、用小止损博弈。"
  ],
  "trading_implication": "见顶论辨析是用客观规则过滤市场恐慌言论的纪律工具。核心判据是同级别EMA60是否被有效破坏：未破则趋势延续，应在回踩支撑处顺势做多而非追空。日线未跌破关键支撑（4527）前不进入熊市，若站上关键位形成W底可看一倍涨幅至5240。避免被news/fake news忽悠，按级别逐级寻找支撑，趋势真破坏时止损出场即可。",
  "merge_notes": null,

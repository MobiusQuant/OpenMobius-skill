{
  "global_card_id": "rejection_wick",
  "global_canonical": "Rejection Wick",
  "type": "merged_concept",
  "school": "Price Action",
  "aliases": [
    "Rejection",
    "Rejection Candle",
    "bunch of wicks",
    "long rejection wick",
    "long wick",
    "wick cluster"
  ],
  "definition": "A long candle wick showing price was pushed to a level but aggressively rejected, indicating strong buying or selling pressure at that zone. The wick's length relative to the candle body signals rejection intensity. May appear as a single candle or a cluster of three to four wicks at the same level. Wick extremes contain less volume than candle bodies, so effective swing points for divergence analysis should be measured at approximately half the wick or the nearest key level rather than the wick tip.",
  "definition_per_source": {
    "SMC-Supplement-PLv-X125": "A long candle wick showing price was pushed to a level but aggressively rejected, indicating strong buying or selling pressure at that zone. The wick's length relative to the candle body signals rejection intensity. May appear as a single candle or a cluster of three to four wicks at the same level. Wick extremes contain less volume than candle bodies, so effective swing points for divergence analysis should be measured at approximately half the wick or the nearest key level rather than the wick tip."
  },
  "identification_rules": [
    "Identify a candle with a wick significantly longer than its body, showing price traveled to a level and was sharply pushed back before the close.",
    "The rejection wick must form at or near a key technical level such as support/resistance, Fibonacci Gold Zone (0.5–0.618 retracement), parallel channel boundary, or a moving average (21- or 50-period).",
    "The wick direction must align with the expected trade bias — e.g., a long lower wick at support signals buying pressure in an uptrend; a long upper wick at resistance signals selling pressure in a downtrend.",
    "Wait for the candle with the rejection wick to close before treating it as a valid signal.",
    "A candle that is too small does not qualify; wait for a subsequent candle showing clear directional commitment.",
    "For cluster-based identification on the 5-minute time frame, look for three or four long wicks concentrated at the same price level, indicating repeated failed attempts to break through.",
    "For regular divergence entries, require two consecutive rejection candles in the anticipated direction; for hidden divergence entries, a single strong rejection candle is sufficient.",
    "When measuring swing points for divergence analysis, use approximately half the wick length or the nearest channel/key level rather than the wick extreme, as wicks contain less volume than candle bodies.",
    "Confirm the rejection wick aligns with the prevailing trend direction for trend continuation setups, or with a confirmed divergence signal for reversal setups."
  ],
  "common_mistakes": [
    "Trading rejection wicks on lower time frames (e.g., 1-minute) without prior higher time frame analysis, leading to frequent stop-outs in volatile conditions.",
    "Acting on a rejection wick in isolation without confluence from other signals such as RSI divergence, Fibonacci levels, moving averages, or support/resistance.",
    "Entering before the rejection wick candle has closed, risking a false signal.",
    "Treating any long wick as a rejection wick regardless of whether it occurs at a meaningful technical level.",
    "Ignoring that rejection wicks during consolidation or ranging markets are unreliable, as Fibonacci retracements and trend-based signals do not work well in those conditions.",
    "Entering on a small or weak candle that does not constitute a proper rejection rather than waiting for a clear rejection wick.",
    "Using only one rejection candle for regular divergence entries instead of waiting for two rejection candles to confirm the reversal.",
    "Failing to place the stop loss beyond the rejection wick extreme, exposing the trade to premature stop-outs.",
    "Measuring divergence swing points at the extreme tip of a large wick instead of using approximately half the wick or the channel boundary, leading to inaccurate divergence readings.",
    "Ignoring the prevailing trend direction and attempting to use wick clusters as reversal signals rather than trend continuation entries."
  ],
  "trading_implication": "A rejection wick serves as a confirmation or entry trigger at key levels. For trend continuation, enter in the trend direction when rejection wicks appear at Fibonacci, moving average, or channel levels. For divergence-based trades, enter at the close of the required rejection candle(s) — two for regular divergence reversals, one for hidden divergence continuations. Place stop losses beyond the wick extreme or channel boundary. Target a minimum 1:2 risk-to-reward ratio. Best used with higher time frame analysis and confluence from divergence, moving averages, or candlestick patterns.",
  "merge_notes": null,
